# ── PII / Secrets ──────────────────────────────────────────────
config.local.yaml
.env
secrets.env
.pii-blocklist
**/allowed_tokens.json
**/dispatch-push-config.json
**/dispatch-apns-tokens.json

# ── Runtime State ─────────────────────────────────────────────
# Anchored: the unanchored `state/` also matched apps/dispatch-app/src/state/,
# so the app's unreadAgents/unreadChats modules were never committed and got
# lost — breaking `expo export` on every daemon restart (2026-09-18).
/state/
sessions/
logs/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/
dist/
build/

# ── pytest ────────────────────────────────────────────────────
.pytest_cache/

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
._*

# ── Editor ────────────────────────────────────────────────────
*.swp
*.swo
*~
.idea/
.vscode/

# ── Node (for menubar app) ───────────────────────────────────
node_modules/

# ── Backup from migration ────────────────────────────────────
skills.bak/

# ── Claude Code ───────────────────────────────────────────────
.claude/

# ── LaunchD (system-specific) ──────────────────────────────────
launchd/*.plist
skills/tts/models/
skills/seedbox/
skills/passthepopcorn/
skills/broadcasthenet/
skills/sven-pages/.api-key
skills/sven-pages/worker/.wrangler/
skills/chrome-control/closed_tabs.log

# ── PII-heavy skills ─────────────────────────────────────────
skills/vacation-house/
# Sensitive financial data
skills/personal-finances/
services/dispatch-api/certs/

# Runtime artifacts, not repo skills
skills/synced/
# Local config backups (contain secrets)
config.local.yaml.bak-*
