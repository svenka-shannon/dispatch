{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git push origin main)",
      "Bash(git push origin HEAD)",
      "Bash(git push origin HEAD:main)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/webfetch/hooks/webfetch-block.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": []
  },
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
