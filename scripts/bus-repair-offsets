#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""
bus-repair-offsets — repair bus.db after the offset-reuse bug.

Background: the producer used to derive next-offset from MAX(records.offset).
Once retention archived every live row of a topic, offsets restarted at 0
while consumer committed offsets kept their old high-water marks — so every
new record on that topic landed BELOW the committed offset and consumers went
permanently deaf (this silently dropped all task.requested events for days).

This script, in one transaction:
  1. Creates the durable topic_offsets counter table if missing.
  2. For topics where live offsets overlap archived offsets (the reuse
     footprint), shifts the live rows above the archive range so the audit
     trail survives the next prune (INSERT OR IGNORE would drop them).
  3. Advances committed consumer offsets past the shifted rows — the events
     were never processed on time and are stale; replaying days-old tasks
     (SMS sends, agent runs) would be worse than skipping them.
  4. Seeds topic_offsets for every known topic/partition with
     MAX(live, archive, committed) + 1.

Safe to re-run (idempotent: no overlap → no shift; counter seeding is
monotonic). Run while the daemon is STOPPED, then restart it.

Usage:
    bus-repair-offsets [--db PATH] [--dry-run]
"""
import argparse
import sqlite3
import sys
import time
from pathlib import Path

DEFAULT_DB = Path.home() / "dispatch" / "state" / "bus.db"


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--db", type=Path, default=DEFAULT_DB)
    ap.add_argument("--dry-run", action="store_true", help="report, change nothing")
    args = ap.parse_args()

    conn = sqlite3.connect(args.db, timeout=30)
    conn.execute("PRAGMA journal_mode=WAL")
    now_ms = int(time.time() * 1000)

    conn.execute("BEGIN IMMEDIATE")
    try:
        conn.execute(
            """CREATE TABLE IF NOT EXISTS topic_offsets (
                   topic TEXT NOT NULL,
                   partition INTEGER NOT NULL,
                   next_offset INTEGER NOT NULL,
                   PRIMARY KEY (topic, partition)
               ) WITHOUT ROWID"""
        )

        # Every (topic, partition) seen anywhere.
        tps = [
            tuple(r)
            for r in conn.execute(
                """SELECT topic, partition FROM records
                   UNION SELECT topic, partition FROM records_archive
                   UNION SELECT topic, partition FROM consumer_offsets
                   GROUP BY 1, 2"""
            )
        ]

        for topic, part in sorted(tps):
            (live_min, live_max) = conn.execute(
                "SELECT MIN(offset), MAX(offset) FROM records WHERE topic=? AND partition=?",
                (topic, part),
            ).fetchone()
            (arch_max,) = conn.execute(
                "SELECT COALESCE(MAX(offset), -1) FROM records_archive WHERE topic=? AND partition=?",
                (topic, part),
            ).fetchone()
            (committed_max,) = conn.execute(
                "SELECT COALESCE(MAX(committed_offset), -1) FROM consumer_offsets WHERE topic=? AND partition=?",
                (topic, part),
            ).fetchone()

            # 2. Shift live rows that reuse archived offsets.
            if live_min is not None and live_min <= arch_max:
                shift = arch_max + 1 - live_min
                print(
                    f"[{topic}:{part}] OVERLAP live {live_min}..{live_max} vs archive max "
                    f"{arch_max} -> shifting live rows +{shift} to "
                    f"{live_min + shift}..{live_max + shift}"
                )
                if not args.dry_run:
                    # shift >= span, so the target range can't collide with rows
                    # not yet visited by the UPDATE.
                    assert live_min + shift > live_max, "shift would self-collide"
                    conn.execute(
                        "UPDATE records SET offset = offset + ? WHERE topic=? AND partition=?",
                        (shift, topic, part),
                    )
                live_max = live_max + shift

                # 3. Skip the shifted (stale, never-processed) rows: park every
                # group's committed offset at the new live max.
                for (grp, cur) in conn.execute(
                    "SELECT group_id, committed_offset FROM consumer_offsets "
                    "WHERE topic=? AND partition=?",
                    (topic, part),
                ).fetchall():
                    if cur < live_max:
                        print(
                            f"[{topic}:{part}]   group '{grp}' committed {cur} -> {live_max} "
                            f"(skipping stale shifted rows)"
                        )
                        if not args.dry_run:
                            conn.execute(
                                "UPDATE consumer_offsets SET committed_offset=?, updated_at=? "
                                "WHERE group_id=? AND topic=? AND partition=?",
                                (live_max, now_ms, grp, topic, part),
                            )
                committed_max = max(committed_max, live_max)

            # 4. Seed the counter (monotonic).
            next_offset = max(live_max if live_max is not None else -1,
                              arch_max, committed_max) + 1
            print(f"[{topic}:{part}] topic_offsets.next_offset = {next_offset}")
            if not args.dry_run:
                conn.execute(
                    "INSERT INTO topic_offsets (topic, partition, next_offset) VALUES (?,?,?) "
                    "ON CONFLICT(topic, partition) DO UPDATE SET next_offset = excluded.next_offset "
                    "WHERE excluded.next_offset > topic_offsets.next_offset",
                    (topic, part, next_offset),
                )

        if args.dry_run:
            conn.execute("ROLLBACK")
            print("\nDRY RUN — nothing changed.")
        else:
            conn.execute("COMMIT")
            print("\nRepair committed.")
    except Exception:
        conn.execute("ROLLBACK")
        raise
    finally:
        conn.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
