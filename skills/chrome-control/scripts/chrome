#!/usr/bin/env python3
"""
Chrome Control CLI

Control Chrome browser from the command line via native messaging extension.
Supports multiple Chrome profiles simultaneously.

Usage:
    chrome profiles                  List available Chrome profiles
    chrome [-p PROFILE] tabs         List all open tabs
    chrome [-p PROFILE] open <url>   Open new tab with URL
    chrome [-p PROFILE] close <tab_id>  Close a tab
    chrome [-p PROFILE] focus <tab_id>  Focus/activate a tab
    chrome [-p PROFILE] navigate <tab_id> <url>  Navigate tab to URL

    chrome [-p PROFILE] fetch <url>       One-shot: open, wait for JS render, print text, close
                                          Flags: --html --keep-open --timeout SEC --min-chars N

    chrome [-p PROFILE] read <tab_id>     Read interactive elements
    chrome [-p PROFILE] text <tab_id>     Get page text content
    chrome [-p PROFILE] html <tab_id>     Get page HTML
    chrome [-p PROFILE] find <tab_id> <query>  Find elements containing text

    chrome [-p PROFILE] click <tab_id> <ref>      Click element by ref
    chrome [-p PROFILE] click-at <tab_id> <x> <y> Click at coordinates
    chrome [-p PROFILE] click-by-name <tab_id> <name>  Click by accessible name (bypasses CSP)
    chrome [-p PROFILE] type <tab_id> <ref> <text> Type into element
    chrome [-p PROFILE] input <tab_id> <ref> <val> Set form input value
    chrome [-p PROFILE] key <tab_id> <key>        Send key
    chrome [-p PROFILE] scroll <tab_id> <dir>     Scroll page
    chrome [-p PROFILE] hover <tab_id> <x> <y>    Hover at coordinates
    chrome [-p PROFILE] os-type <tab_id> [--at X,Y] (--text T | --stdin | --secret-service S)
                          [--clear] [--select] [--enter]   LAST-RESORT OS-level click+type
                          (aborts unless Chrome is frontmost; see `chrome os-type --help`)

    chrome [-p PROFILE] screenshot <tab_id> [--timeout SEC]  Take screenshot (default timeout 30s)
    chrome shot-purge [--since 10m] [--dry-run]  Delete recent screenshots (e.g. ones showing a card)
    chrome [-p PROFILE] js <tab_id> <code>   Execute JavaScript
    chrome [-p PROFILE] upload <tab_id> <selector|auto> <file>...  Attach local files to a file input (works on Gmail)

    chrome [-p PROFILE] console <tab_id>  Read console messages
    chrome [-p PROFILE] network <tab_id>  Read network requests
    chrome [-p PROFILE] ping              Test connection
    chrome reset                          Kill stuck native_host processes, then auto-wake the worker
    chrome wake                           Revive an evicted service worker (no toolbar click needed)
    chrome reload-extension               Reload the unpacked extension (picks up background.js changes)

Options:
    -p, --profile PROFILE    Target profile (name, email prefix, or index)
                             If omitted, uses first available profile
"""

import sys
import socket
import json
import time
import shutil
import os
import subprocess
from pathlib import Path
from datetime import datetime

REGISTRY_PATH = "/tmp/chrome_control_registry.json"
PICTURES_DIR = Path.home() / "Pictures" / "chrome-screenshots"

# The installed native-messaging-host manifest pins the exact extension ID in
# its allowed_origins. We read it from here so `chrome wake` can navigate Chrome
# to one of the extension's own pages (the programmatic equivalent of clicking
# the toolbar icon — it forces an evicted MV3 service worker to start).
NATIVE_HOST_MANIFEST = (
    Path.home()
    / "Library/Application Support/Google/Chrome"
    / "NativeMessagingHosts/com.dispatch.chrome_control.json"
)


def extension_id():
    """Return the chrome-control extension ID from the native-host manifest, or None."""
    try:
        with open(NATIVE_HOST_MANIFEST) as f:
            origins = json.load(f).get("allowed_origins", [])
        for origin in origins:
            if origin.startswith("chrome-extension://"):
                return origin.split("//", 1)[1].rstrip("/")
    except (OSError, ValueError, KeyError):
        pass
    return None


# Chrome profile dir holding Preferences / Secure Preferences. Default profile
# is the common case; we don't try every profile (keep it simple, fall back
# gracefully if the extension isn't there).
CHROME_DEFAULT_PROFILE_DIR = (
    Path.home() / "Library/Application Support/Google/Chrome/Default"
)

# disable_reasons bitmask values from Chromium's extension_disabled_reason.h.
# Only the ones worth naming to a human are listed.
_DISABLE_REASON_NAMES = {
    1: "disabled by user",
    2: "permissions increase needs re-approval",
    4: "needs a reload",
    8: "unsupported requirement",
    16: "sideload wipeout",
    32: "unknown from sync",
    128: "not verified",
    256: "greylist",
    512: "corrupted (Chrome's content-verification failed)",
    1024: "corrupted (Chrome's content-verification failed)",
    2048: "blocked as malware",
    8192: "needs reinstall",
}


def _describe_disable_reasons(mask):
    """Human-readable list of disable reasons from a bitmask int."""
    if not mask:
        return []
    out = []
    for bit, name in _DISABLE_REASON_NAMES.items():
        if mask & bit:
            out.append(name)
    if not out:
        out.append(f"reason code {mask}")
    return out


def extension_prefs_state(ext_id):
    """Inspect the Chrome Default profile's Preferences for this extension.

    Returns one of:
      {"found": False}                                  — not in Preferences (maybe
                                                          a non-Default profile, or
                                                          prefs unreadable)
      {"found": True, "enabled": True,  "reasons": []}  — Chrome says it's enabled
      {"found": True, "enabled": False, "reasons": [...]}  — disabled / errored;
                                                          reasons describes why
    """
    for fname in ("Preferences", "Secure Preferences"):
        path = CHROME_DEFAULT_PROFILE_DIR / fname
        try:
            with open(path) as f:
                prefs = json.load(f)
        except (OSError, ValueError):
            continue
        settings = (
            prefs.get("extensions", {}).get("settings", {})
        )
        entry = settings.get(ext_id)
        if not isinstance(entry, dict):
            continue
        # state: 1 = ENABLED, 0 = DISABLED. Chrome ≥127 omits the key entirely
        # while the extension is healthy (disable state lives only in
        # disable_reasons once disabled), so a missing key means ENABLED —
        # treating it as disabled produced false "DISABLED/errored" diagnoses
        # on a working extension (July 2026 outage postmortem).
        state = entry.get("state")
        reasons_mask = entry.get("disable_reasons", 0) or 0
        # Some Chrome versions store a single int; older ones a list of ints.
        if isinstance(reasons_mask, list):
            combined = 0
            for r in reasons_mask:
                try:
                    combined |= int(r)
                except (TypeError, ValueError):
                    pass
            reasons_mask = combined
        try:
            reasons_mask = int(reasons_mask)
        except (TypeError, ValueError):
            reasons_mask = 0
        enabled = state in (None, 1) and reasons_mask == 0
        return {
            "found": True,
            "enabled": enabled,
            "state": state,
            "reasons": _describe_disable_reasons(reasons_mask),
        }
    return {"found": False}


def load_registry() -> dict:
    """Load the profile registry."""
    try:
        if os.path.exists(REGISTRY_PATH):
            with open(REGISTRY_PATH, 'r') as f:
                return json.load(f)
    except Exception:
        pass
    return {"profiles": {}}


def get_profiles() -> list:
    """Get list of available profiles."""
    registry = load_registry()
    profiles = []
    for ext_id, info in registry.get("profiles", {}).items():
        socket_path = info.get("socket")
        if socket_path and os.path.exists(socket_path):
            profiles.append({
                "id": ext_id,
                "name": info.get("name", ext_id[:8]),
                "socket": socket_path
            })
    return profiles


def find_profile_socket(profile_selector: str = None) -> str:
    """Find socket path for given profile selector."""
    profiles = get_profiles()

    if not profiles:
        print("Error: No Chrome profiles connected", file=sys.stderr)
        print("Make sure Chrome is running with the extension loaded", file=sys.stderr)
        sys.exit(1)

    if profile_selector is None:
        # Use first available profile
        return profiles[0]["socket"]

    # Try to match by index
    try:
        idx = int(profile_selector)
        if 0 <= idx < len(profiles):
            return profiles[idx]["socket"]
    except ValueError:
        pass

    # Try to match by name (case-insensitive prefix match)
    selector_lower = profile_selector.lower()
    for p in profiles:
        if p["name"].lower().startswith(selector_lower):
            return p["socket"]
        if p["id"].lower().startswith(selector_lower):
            return p["socket"]

    print(f"Error: Profile '{profile_selector}' not found", file=sys.stderr)
    print("Available profiles:", file=sys.stderr)
    for i, p in enumerate(profiles):
        print(f"  {i}: {p['name']}", file=sys.stderr)
    sys.exit(1)


class ChromeControl:
    def __init__(self, socket_path: str):
        self.sock = None
        self.socket_path = socket_path

    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(self.socket_path)
        self.sock.settimeout(30)

    def send(self, command: str, timeout: int = 30, **params) -> dict:
        if not self.sock:
            self.connect()
        self.sock.settimeout(timeout)
        msg = json.dumps({"command": command, "params": params})
        self.sock.sendall(msg.encode())
        data = b""
        while b"\n" not in data:
            chunk = self.sock.recv(65536)
            if not chunk:
                # 2026-10-01: a closed socket returns b"" forever; this loop used to spin until
                # the caller was killed (fill-card-iframe hung 30 min after the card was typed).
                raise ConnectionError(f"native host closed the connection during '{command}'")
            data += chunk
        return json.loads(data.decode().strip())


def parse_tab_id(value: str) -> int:
    """Parse a tab ID from string, with a friendly error on failure."""
    try:
        return int(value)
    except ValueError:
        print(f"Error: '{value}' is not a valid tab ID. Use 'chrome tabs' to list tab IDs.", file=sys.stderr)
        sys.exit(1)


# Schemes that are valid Chrome navigation targets without needing https:// prepended.
# Without this list, `chrome open about:blank` becomes `https://about:blank` which
# the extension rejects with "Invalid url" — the actual error users hit in 2026-04.
_VALID_URL_SCHEMES = (
    "http://", "https://", "file://",
    "about:", "chrome:", "chrome-extension:", "edge:", "view-source:",
    "data:", "javascript:", "blob:", "ftp:", "mailto:",
)


def normalize_url(url: str) -> str:
    """Add https:// only when the URL has no recognized scheme.

    Preserves about:, chrome:, data:, javascript:, file://, etc. so internal
    pages and special URIs aren't mangled into 'https://about:blank' style
    nonsense.
    """
    lowered = url.lower()
    if any(lowered.startswith(s) for s in _VALID_URL_SCHEMES):
        return url
    return "https://" + url


def get_result(response):
    """Extract result from response, handling errors."""
    if "error" in response:
        print(f"Error: {response['error']}", file=sys.stderr)
        sys.exit(1)
    return response.get("result", response)


def cmd_tabs(client, args):
    """List all open tabs."""
    result = get_result(client.send("list_tabs"))
    tabs = result.get("tabs", [])
    if not tabs:
        print("No tabs open")
        return
    for tab in tabs:
        title = tab.get("title", "")
        url = tab.get("url", "")
        print(f"{tab['id']}  {title}")
        print(f"      {url}")


def cmd_open(client, args):
    """Open a new tab with URL."""
    if len(args) < 1:
        print("Usage: chrome open <url>", file=sys.stderr)
        sys.exit(1)
    url = normalize_url(args[0])
    result = get_result(client.send("open_tab", url=url))
    print(f"Opened tab {result.get('tabId')}: {url}")


def cmd_close(client, args):
    """Close a tab."""
    if len(args) < 1:
        print("Usage: chrome close <tab_id>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    get_result(client.send("close_tab", tabId=tab_id))
    print(f"Closed tab {tab_id}")


def cmd_focus(client, args):
    """Focus a tab."""
    if len(args) < 1:
        print("Usage: chrome focus <tab_id>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    get_result(client.send("focus_tab", tabId=tab_id))
    print(f"Focused tab {tab_id}")


def cmd_navigate(client, args):
    """Navigate tab to URL."""
    if len(args) < 2:
        print("Usage: chrome navigate <tab_id> <url|back|forward>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    url = args[1]
    if url not in ("back", "forward"):
        url = normalize_url(url)
    get_result(client.send("navigate", tabId=tab_id, url=url))
    print(f"Navigated tab {tab_id} to {url}")


def cmd_read(client, args):
    """Read interactive elements from page."""
    if len(args) < 1:
        print("Usage: chrome read <tab_id> [filter]", file=sys.stderr)
        print("  Filters: interactive (default), all, forms, links, buttons", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    filter_type = args[1] if len(args) > 1 else "interactive"
    result = get_result(client.send("read_page", tabId=tab_id, filter=filter_type))
    elements = result.get("elements", [])
    if not elements:
        print("No elements found")
        return
    for el in elements:
        ref = el.get("ref", "")
        role = el.get("role", "")
        label = el.get("label", "")[:60] if el.get("label") else ""
        tag = el.get("tag", "")
        line = f"{ref:8} {role:12} {tag:8} {label}"
        print(line)


def cmd_text(client, args):
    """Get page text content."""
    if len(args) < 1:
        print("Usage: chrome text <tab_id>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    result = get_result(client.send("get_page_text", tabId=tab_id))
    print(result if isinstance(result, str) else result.get("text", result))


def cmd_html(client, args):
    """Get page HTML."""
    if len(args) < 1:
        print("Usage: chrome html <tab_id>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    result = get_result(client.send("get_page_html", tabId=tab_id))
    print(result if isinstance(result, str) else result.get("html", result))


def cmd_fetch(client, args):
    """Open a URL, wait for JS-rendered content, print it, then close the tab.

    One-shot replacement for the manual open -> poll text -> close dance.
    Polls until the page text stops growing (or --timeout), so SPAs and
    Shopify/React/Next.js pages return real content instead of an empty body.
    """
    keep_open = False
    want_html = False
    timeout = 20.0
    min_chars = 200
    positional = []

    i = 0
    while i < len(args):
        a = args[i]
        if a == "--keep-open":
            keep_open = True
        elif a == "--html":
            want_html = True
        elif a == "--timeout":
            i += 1
            if i >= len(args):
                print("Error: --timeout requires a value (seconds)", file=sys.stderr)
                sys.exit(1)
            timeout = float(args[i])
        elif a == "--min-chars":
            i += 1
            if i >= len(args):
                print("Error: --min-chars requires a value", file=sys.stderr)
                sys.exit(1)
            min_chars = int(args[i])
        else:
            positional.append(a)
        i += 1

    if not positional:
        print("Usage: chrome fetch <url> [--html] [--keep-open] "
              "[--timeout SECONDS] [--min-chars N]", file=sys.stderr)
        sys.exit(1)

    url = normalize_url(positional[0])
    result = get_result(client.send("open_tab", url=url))
    tab_id = result.get("tabId")
    if tab_id is None:
        print(f"Error: failed to open tab for {url}", file=sys.stderr)
        sys.exit(1)

    action = "get_page_html" if want_html else "get_page_text"
    key = "html" if want_html else "text"

    content = ""
    prev_len = -1
    deadline = time.monotonic() + timeout

    try:
        while True:
            try:
                raw = get_result(client.send(action, tabId=tab_id))
                content = raw if isinstance(raw, str) else raw.get(key, "") or ""
            except Exception:
                content = content or ""

            cur_len = len(content.strip())
            # Settled: enough content AND it stopped growing since last poll.
            if cur_len >= min_chars and cur_len == prev_len:
                break
            if time.monotonic() >= deadline:
                break
            prev_len = cur_len
            time.sleep(0.5)
    finally:
        if not keep_open:
            try:
                get_result(client.send("close_tab", tabId=tab_id))
            except Exception:
                print(f"Warning: could not close tab {tab_id}", file=sys.stderr)

    if not content.strip():
        print(f"Error: no content from {url} after {timeout:.0f}s. "
              f"Page may need login, or try --timeout 40.", file=sys.stderr)
        sys.exit(1)

    print(content)
    if keep_open:
        print(f"\n[tab {tab_id} left open]", file=sys.stderr)


def cmd_find(client, args):
    """Find elements by text query."""
    if len(args) < 2:
        print("Usage: chrome find <tab_id> <query>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    query = " ".join(args[1:])
    result = get_result(client.send("find", tabId=tab_id, query=query))
    elements = result.get("elements", result) if isinstance(result, dict) else result
    if not elements:
        print("No matches found")
        return
    for el in (elements if isinstance(elements, list) else [elements]):
        if isinstance(el, dict):
            ref = el.get("ref", "")
            label = el.get("label", "")[:60]
            print(f"{ref:8} {label}")


def cmd_click(client, args):
    """Click element by ref."""
    if len(args) < 2:
        print("Usage: chrome click <tab_id> <ref>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    ref = args[1]
    get_result(client.send("click", tabId=tab_id, selector=ref))
    print(f"Clicked {ref}")


def cmd_click_at(client, args):
    """Click at coordinates."""
    if len(args) < 3:
        print("Usage: chrome click-at <tab_id> <x> <y>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    x, y = int(args[1]), int(args[2])
    get_result(client.send("click_at", tabId=tab_id, x=x, y=y))
    print(f"Clicked at ({x}, {y})")


def cmd_type(client, args):
    """Type text into element."""
    if len(args) < 3:
        print("Usage: chrome type <tab_id> <ref> <text>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    ref = args[1]
    text = " ".join(args[2:])
    get_result(client.send("type", tabId=tab_id, selector=ref, text=text))
    print(f"Typed into {ref}")


def cmd_input(client, args):
    """Set form input value."""
    if len(args) < 3:
        print("Usage: chrome input <tab_id> <ref> <value>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    ref = args[1]
    value = " ".join(args[2:])
    get_result(client.send("form_input", tabId=tab_id, ref=ref, value=value))
    print(f"Set {ref} = {value}")


def cmd_key(client, args):
    """Send key press."""
    if len(args) < 2:
        print("Usage: chrome key <tab_id> <key> [modifiers]", file=sys.stderr)
        print("  Keys: Enter, Tab, Escape, Backspace, ArrowUp, ArrowDown, etc.", file=sys.stderr)
        print("  Modifiers: ctrl, alt, shift, meta (comma-separated)", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    key = args[1]
    modifiers = args[2].split(",") if len(args) > 2 else None
    get_result(client.send("key", tabId=tab_id, key=key, modifiers=modifiers))
    print(f"Sent key: {key}")


def cmd_insert_text(client, args):
    """Insert text at current focus (works in iframes)."""
    if len(args) < 2:
        print("Usage: chrome insert-text <tab_id> <text>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    text = " ".join(args[1:])
    get_result(client.send("insert_text", tabId=tab_id, text=text))
    print(f"Inserted text")


def cmd_iframe_click(client, args):
    """Click element inside iframe by CSS selector."""
    if len(args) < 2:
        print("Usage: chrome iframe-click <tab_id> <selector>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    selector = " ".join(args[1:])
    result = get_result(client.send("iframe_click", tabId=tab_id, selector=selector))
    print(f"Result: {result.get('result', result)}")


def cmd_click_by_name(client, args):
    """Click element by accessible name using Chrome accessibility tree."""
    if len(args) < 2:
        print("Usage: chrome click-by-name <tab_id> <name> [--role <role>] [--index <n>]", file=sys.stderr)
        print("  Uses Chrome's accessibility tree to find elements.", file=sys.stderr)
        print("  Bypasses CSP restrictions.", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])

    # Parse args
    name = args[1]
    role = None
    index = 0
    i = 2
    while i < len(args):
        if args[i] == "--role" and i + 1 < len(args):
            role = args[i + 1]
            i += 2
        elif args[i] == "--index" and i + 1 < len(args):
            index = int(args[i + 1])
            i += 2
        else:
            # Append to name if not a flag
            name += " " + args[i]
            i += 1

    params = {"tabId": tab_id, "name": name, "index": index}
    if role:
        params["role"] = role

    result = get_result(client.send("click_by_name", **params))
    if result.get("clicked"):
        print(f"Clicked element: {result.get('name', name)} (role: {result.get('role', 'unknown')})")
    else:
        print(f"Could not find element with name '{name}'", file=sys.stderr)
        if result.get("matchesFound"):
            print(f"  Found {result.get('matchesFound')} partial matches", file=sys.stderr)
        sys.exit(1)


def cmd_iframe_type(client, args):
    """Type text using debugger key events (works for iframes)."""
    if len(args) < 2:
        print("Usage: chrome iframe-type <tab_id> <text>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    text = " ".join(args[1:])
    result = get_result(client.send("iframe_type", tabId=tab_id, text=text))
    print(f"Typed: {result}")


def cmd_iframe_eval(client, args):
    """Execute JS inside a cross-origin iframe via Chrome debugger Target API."""
    if len(args) < 3:
        print("Usage: chrome iframe-eval <tab_id> <url_pattern> <code>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    url_pattern = args[1]
    code = " ".join(args[2:])
    result = get_result(client.send("iframe_target_eval", tabId=tab_id, urlPattern=url_pattern, code=code))
    if result is not None:
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)


def cmd_scroll(client, args):
    """Scroll the page."""
    if len(args) < 2:
        print("Usage: chrome scroll <tab_id> <direction> [amount]", file=sys.stderr)
        print("  Directions: up, down, left, right", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    direction = args[1]
    amount = int(args[2]) if len(args) > 2 else 3
    get_result(client.send("scroll", tabId=tab_id, direction=direction, amount=amount))
    print(f"Scrolled {direction}")


def cmd_hover(client, args):
    """Hover at coordinates."""
    if len(args) < 3:
        print("Usage: chrome hover <tab_id> <x> <y>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    x, y = int(args[1]), int(args[2])
    get_result(client.send("hover", tabId=tab_id, x=x, y=y))
    print(f"Hovering at ({x}, {y})")


def cmd_screenshot(client, args):
    """Take screenshot and save to ~/Pictures.

    --timeout SEC (default 30): 2026-10-18 a screenshot hung ~120s while a native
    <select> dropdown was open (captureVisibleTab never returns). Fail fast instead.
    """
    timeout = 30.0
    positional = []
    i = 0
    while i < len(args):
        if args[i] == "--timeout":
            i += 1
            if i >= len(args):
                print("Error: --timeout requires a value (seconds)", file=sys.stderr)
                sys.exit(1)
            timeout = float(args[i])
        else:
            positional.append(args[i])
        i += 1
    if len(positional) < 1:
        print("Usage: chrome screenshot <tab_id> [--timeout SEC]   (default 30s)", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(positional[0])
    try:
        result = get_result(client.send("screenshot", timeout=timeout, tabId=tab_id))
    except socket.timeout:
        print(f"Error: screenshot timed out after {timeout:.0f}s. A native <select> dropdown or an "
              "OS dialog may be open (Chrome can't capture while it is). Press Escape / dismiss it, "
              "or capture the whole screen instead: screencapture -x /tmp/screen.png",
              file=sys.stderr)
        sys.exit(1)

    # Get source path
    src_path = result.get("screenshotPath")
    if not src_path:
        print("Error: No screenshot path returned", file=sys.stderr)
        sys.exit(1)

    # Create destination directory
    PICTURES_DIR.mkdir(parents=True, exist_ok=True)

    # Generate filename with timestamp
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    dest_path = PICTURES_DIR / f"screenshot_{timestamp}.jpg"

    # Move (not copy) so the native host's temp copy doesn't linger — screenshots of
    # checkout pages can show card data and must be purgeable from one place.
    try:
        shutil.move(src_path, dest_path)
    except OSError:
        shutil.copy2(src_path, dest_path)

    # Resize if too large (prevents buffer overflow when Claude reads it)
    # Target: max 1600px on longest side (keeps ~800KB file size, well under 1MB SDK limit)
    try:
        result = subprocess.run(
            ["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(dest_path)],
            capture_output=True, text=True, timeout=5,
        )
        width = height = 0
        for line in result.stdout.splitlines():
            if "pixelWidth" in line:
                width = int(line.split(":")[-1].strip())
            elif "pixelHeight" in line:
                height = int(line.split(":")[-1].strip())

        MAX_DIM = 1600
        if width > MAX_DIM or height > MAX_DIM:
            subprocess.run(
                ["sips", "--resampleHeightWidthMax", str(MAX_DIM), str(dest_path)],
                capture_output=True, timeout=10,
            )
    except Exception:
        pass  # If resize fails, still return the original

    # Print the path (this is what the user sees)
    print(dest_path)


# ---------------------------------------------------------------------------
# OS-level typing fallback: `chrome os-type`  (LAST RESORT)
#
# 2026-10-18: on OpenTable and Walmart checkouts, read/type/insert-text could not
# reach the inputs (out-of-process Stripe iframes, React forms). What worked was
# focus + an OS-level click + OS-level keystrokes with Chrome frontmost. This
# wraps that recipe with the guard rails that were missing that day:
#   - abort if Chrome is not frontmost (a TCC "wants to record your screen"
#     dialog stole the keystrokes),
#   - window-relative coordinate mapping computed live (never hardcoded),
#   - a settle delay + harmless primer (the first char was dropped after a click),
#   - text fed to cliclick on STDIN (`cliclick -f -`), so secrets never hit argv/ps.
# ---------------------------------------------------------------------------

CHROME_BUNDLE_ID = "com.google.Chrome"
SCREENSHOT_MAX_DIM = 1600  # cmd_screenshot downsizes to this; os-type maps coords back through it


class OsTypeError(Exception):
    """Raised by os_type(); exit_code 3 = Chrome not frontmost."""

    def __init__(self, msg, exit_code=1):
        super().__init__(msg)
        self.exit_code = exit_code


def _cliclick_path():
    return shutil.which("cliclick") or "/opt/homebrew/bin/cliclick"


def frontmost_app():
    """(bundle_id, display_name) of the frontmost macOS app via lsappinfo; ('', '') if unknown."""
    try:
        asn = subprocess.run(["lsappinfo", "front"], capture_output=True,
                             text=True, timeout=5).stdout.strip()
        if not asn:
            return ("", "")
        out = subprocess.run(["lsappinfo", "info", "-only", "bundleid", "-only", "name", asn],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ("", "")
    vals = {}
    for line in out.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            vals[k.strip().strip('"')] = v.strip().strip('"')
    return (vals.get("CFBundleIdentifier", ""), vals.get("LSDisplayName", ""))


def chrome_is_frontmost(wait=0.0):
    """Poll up to `wait` seconds for Chrome to be frontmost. Returns (ok, bundle_id, name)."""
    deadline = time.monotonic() + wait
    while True:
        bid, name = frontmost_app()
        if bid == CHROME_BUNDLE_ID:
            return True, bid, name
        if time.monotonic() >= deadline:
            return False, bid, name
        time.sleep(0.1)


def _not_frontmost_error(bid, name, when):
    return OsTypeError(
        f"Google Chrome is not the frontmost app {when} (frontmost: {name or '?'} [{bid or '?'}]). "
        "Refusing to send OS keystrokes: they would go to that app. A macOS permission dialog "
        "(e.g. 'python3.14 wants to record your screen') may have stolen focus: approve/deny it "
        "(auth-dialog-monitor skill) and retry.", exit_code=3)


def _main_display_backing_scale():
    """Pixels per point of the main display (1.0 on a non-Retina 1080p panel)."""
    try:
        out = subprocess.run(["system_profiler", "SPDisplaysDataType", "-json"],
                             capture_output=True, text=True, timeout=20).stdout
        data = json.loads(out)
    except (OSError, subprocess.SubprocessError, ValueError):
        return 1.0
    for gpu in data.get("SPDisplaysDataType", []):
        for d in gpu.get("spdisplays_ndrvs", []):
            if d.get("spdisplays_main") == "spdisplays_yes":
                try:
                    px = float(d["_spdisplays_pixels"].split(" x ")[0])
                    pt = float(d["_spdisplays_resolution"].split(" x ")[0])
                    return px / pt if pt else 1.0
                except (KeyError, ValueError, IndexError):
                    return 1.0
    return 1.0


_GEOM_EXPR = ("({sx: screenX, sy: screenY, ow: outerWidth, oh: outerHeight, "
              "iw: innerWidth, ih: innerHeight, dpr: devicePixelRatio})")


def tab_geometry(client, tab_id):
    """Window/viewport geometry of a tab, read live via the CDP isolated world (CSP-safe)."""
    res = client.send("debugger_eval", tabId=tab_id, code="return " + _GEOM_EXPR + ";")
    g = res.get("result") if isinstance(res, dict) else None
    if isinstance(g, dict) and isinstance(g.get("result"), dict):
        g = g["result"]
    if not (isinstance(g, dict) and all(k in g for k in ("sx", "sy", "oh", "iw", "ih", "dpr"))):
        raise OsTypeError(f"could not read window geometry for tab {tab_id}: {str(res)[:200]}")
    return g


def to_screen_point(g, x, y, space="shot"):
    """Map tab coordinates to global screen points (what cliclick wants).

    space: 'shot'   = pixels in a `chrome screenshot` image (default)
           'css'    = CSS viewport px (what `chrome click-at` takes)
           'screen' = already screen points
    Content origin = (screenX, screenY + outerHeight - innerHeight*zoom); e.g. on the
    1920x1080 panel with a 1200px window that is (642, 179). Computed every call, so a
    moved/resized window is handled.
    """
    if space == "screen":
        return int(round(x)), int(round(y))
    dpr = float(g.get("dpr") or 1.0)
    zoom = 1.0 if abs(dpr - 1.0) < 1e-6 else dpr / _main_display_backing_scale()
    if space == "shot":
        raw_w, raw_h = g["iw"] * dpr, g["ih"] * dpr
        s = min(1.0, SCREENSHOT_MAX_DIM / max(raw_w, raw_h, 1))
        x, y = x / (dpr * s), y / (dpr * s)          # -> CSS px
    elif space != "css":
        raise OsTypeError(f"unknown coordinate space '{space}' (use shot|css|screen)")
    left = g["sx"]
    top = g["sy"] + g["oh"] - g["ih"] * zoom
    return int(round(left + x * zoom)), int(round(top + y * zoom))


def shot_to_css(g, x, y):
    """Screenshot pixels -> CSS viewport px (for `click_at`)."""
    dpr = float(g.get("dpr") or 1.0)
    s = min(1.0, SCREENSHOT_MAX_DIM / max(g["iw"] * dpr, g["ih"] * dpr, 1))
    return int(round(x / (dpr * s))), int(round(y / (dpr * s)))


def _cliclick(lines, secret=False):
    """Run cliclick with commands on STDIN (`-f -`): typed text never appears in argv."""
    exe = _cliclick_path()
    if not os.path.exists(exe):
        raise OsTypeError("cliclick not found (brew install cliclick)")
    r = subprocess.run([exe, "-w", "20", "-f", "-"], input="\n".join(lines) + "\n",
                       capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        detail = "(details suppressed: secret input)" if secret else r.stderr.strip()[:300]
        raise OsTypeError(f"cliclick failed (exit {r.returncode}) {detail}")


def _type_lines(text):
    """cliclick lines that type `text` exactly (cliclick -f strips edge whitespace)."""
    if any(c in text for c in "\r\n\t"):
        raise OsTypeError("text contains newline/tab; type it in pieces (use --enter for Enter)")
    core = text.strip(" ")
    lead = len(text) - len(text.lstrip(" "))
    trail = len(text) - len(text.rstrip(" ")) if core else 0
    lines = ["kp:space"] * lead
    if core:
        lines.append("t:" + core)
    lines += ["kp:space"] * trail
    return lines


def read_keychain(service, account=None):
    """Read a Keychain secret in-process (security's stdout, never argv/printed)."""
    cmd = ["security", "find-generic-password", "-s", service, "-w"]
    if account:
        cmd[2:2] = ["-a", account]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        raise OsTypeError(f"keychain item not found: service={service} account={account}")
    return r.stdout.rstrip("\n")


def os_type(client, tab_id, text, at=None, space="shot", clear=False, select=False,
            enter=False, primer=True, settle=0.4, secret=False):
    """Focus tab, verify Chrome frontmost, optional OS click, then OS-type `text`.

    Raises OsTypeError. Returns the screen point clicked (or None).
    """
    get_result(client.send("focus_tab", tabId=tab_id))
    ok, bid, name = chrome_is_frontmost(wait=1.5)
    if not ok:
        raise _not_frontmost_error(bid, name, "after focusing the tab")
    point = None
    if at is not None:
        g = tab_geometry(client, tab_id)
        point = to_screen_point(g, at[0], at[1], space)
        _cliclick([f"c:{point[0]},{point[1]}"])
    time.sleep(settle)                      # let focus land / native popup open
    ok, bid, name = chrome_is_frontmost()
    if not ok:
        raise _not_frontmost_error(bid, name, "right before typing")
    lines = []
    if primer and not select:
        # Harmless key event to wake the field: the 1st real char got dropped after clicks.
        lines += ["kd:shift", "ku:shift", "w:100"]
    if clear and not select:
        lines += ["kd:cmd", "t:a", "ku:cmd", "kp:delete", "w:50"]
    lines += _type_lines(text)
    if select or enter:
        lines += ["w:150", "kp:enter"]
    _cliclick(lines, secret=secret)
    if select:
        time.sleep(0.6)  # the DOM value updates ~0.5s after the native menu closes
    return point


def _parse_xy(s):
    try:
        x, y = s.replace(" ", ",").split(",")
        return float(x), float(y)
    except ValueError:
        raise OsTypeError(f"bad coordinate '{s}' (want X,Y)")


OS_TYPE_HELP = """Usage: chrome os-type <tab_id> [--at X,Y] [--coords shot|css|screen]
                      (--text T | --stdin | --secret-service S [--secret-account A])
                      [--clear] [--select] [--enter] [--no-primer] [--settle SEC]

LAST-RESORT OS-level typing for inputs chrome-control can't reach (out-of-process
payment iframes, React checkout forms). Focuses the tab, aborts (exit 3) unless Google
Chrome is the frontmost app, optionally OS-clicks at X,Y, waits, sends a harmless
primer key, then types via cliclick fed on STDIN (nothing typed ever appears in argv).

  --at X,Y            click here first. Coordinates are in --coords space:
  --coords SPACE      shot (default; pixels in a `chrome screenshot` image), css
                      (viewport px, same as click-at), or screen (global points)
  --text T            non-secret text (it IS in argv — never use for card/CVV/passwords)
  --stdin             read the text from stdin (pipe secrets this way)
  --secret-service S  read the text from Keychain in-process (`--secret-account A`)
  --clear             Cmd+A, Delete before typing
  --select            native <select>: --at opens it, type the OPTION TEXT as shown
                      (e.g. "CA" not "California", "29" not "2029"), then Enter
  --enter             press Enter after typing
  --no-primer         skip the shift-tap primer
  --settle SEC        wait after the click (default 0.4)
"""


def cmd_os_type(client, args):
    """OS-level typing fallback. See OS_TYPE_HELP."""
    if not args or args[0] in ("-h", "--help"):
        print(OS_TYPE_HELP)
        sys.exit(0 if args else 1)
    tab_id = parse_tab_id(args[0])
    opts = {"at": None, "coords": "shot", "text": None, "stdin": False, "service": None,
            "account": None, "clear": False, "select": False, "enter": False,
            "primer": True, "settle": 0.4}
    valued = {"--at": "at", "--coords": "coords", "--text": "text",
              "--secret-service": "service", "--secret-account": "account", "--settle": "settle"}
    flags = {"--stdin": "stdin", "--clear": "clear", "--select": "select", "--enter": "enter"}
    i = 1
    try:
        while i < len(args):
            a = args[i]
            if a in valued:
                if i + 1 >= len(args):
                    raise OsTypeError(f"{a} requires a value")
                opts[valued[a]] = args[i + 1]
                i += 2
                continue
            if a in flags:
                opts[flags[a]] = True
            elif a == "--no-primer":
                opts["primer"] = False
            elif a in ("-h", "--help"):
                print(OS_TYPE_HELP)
                sys.exit(0)
            else:
                raise OsTypeError(f"unknown argument '{a}' (see chrome os-type --help)")
            i += 1
        sources = [opts["text"] is not None, opts["stdin"], opts["service"] is not None]
        if sum(sources) != 1:
            raise OsTypeError("give exactly one of --text, --stdin, --secret-service")
        secret = opts["text"] is None
        if opts["service"]:
            text = read_keychain(opts["service"], opts["account"])
        elif opts["stdin"]:
            text = sys.stdin.read().rstrip("\n")
        else:
            text = opts["text"]
        if not text:
            raise OsTypeError("nothing to type (empty text)")
        at = _parse_xy(opts["at"]) if opts["at"] else None
        point = os_type(client, tab_id, text, at=at, space=opts["coords"], clear=opts["clear"],
                        select=opts["select"], enter=opts["enter"], primer=opts["primer"],
                        settle=float(opts["settle"]), secret=secret)
    except OsTypeError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(e.exit_code)
    where = f" after clicking screen ({point[0]},{point[1]})" if point else ""
    what = "secret, value not shown" if secret else "text"
    print(f"os-type: typed {len(text)} chars ({what}) into tab {tab_id}{where}")
    if opts["select"] and len(text) > 3 and not any(ch.isdigit() for ch in text):
        print(f"Warning: native select type-ahead matches the option LABEL letter by letter; if the "
              f"options are abbreviations, '{text}' picks the wrong one ('California' -> CO). "
              "Type the label exactly as shown ('CA').", file=sys.stderr)
    if opts["select"]:
        print("Native select: verify the chosen option with `chrome screenshot` (dropdown is closed now).")


def _parse_duration(s):
    units = {"s": 1, "m": 60, "h": 3600, "d": 86400}
    s = s.strip().lower()
    try:
        if s and s[-1] in units:
            return float(s[:-1]) * units[s[-1]]
        return float(s)
    except ValueError:
        print(f"Error: bad duration '{s}' (e.g. 90s, 10m, 2h, 1d)", file=sys.stderr)
        sys.exit(1)


def cmd_shot_purge(client, args):
    """Delete recent chrome screenshots (e.g. ones that showed a card). No-match safe.

    chrome shot-purge [--since 10m] [--dry-run]
    Removes ~/Pictures/chrome-screenshots/screenshot_*.jpg plus the native host's
    temp copies (chrome_screenshot_*) modified within the window. Uses Python globbing,
    so there are no zsh 'no matches found' errors.
    """
    import glob
    import tempfile
    since = "10m"
    dry = False
    i = 0
    while i < len(args):
        if args[i] == "--since" and i + 1 < len(args):
            since = args[i + 1]
            i += 2
            continue
        if args[i] == "--dry-run":
            dry = True
        elif args[i] in ("-h", "--help"):
            print("Usage: chrome shot-purge [--since 10m] [--dry-run]")
            return
        else:
            print(f"Error: unknown argument '{args[i]}'", file=sys.stderr)
            sys.exit(1)
        i += 1
    cutoff = time.time() - _parse_duration(since)
    patterns = [str(PICTURES_DIR / "screenshot_*.jpg")]
    for d in {tempfile.gettempdir(), os.environ.get("TMPDIR", ""), "/tmp"}:
        if d:
            patterns.append(os.path.join(d, "chrome_screenshot_*"))
    hits = set()
    for pat in patterns:
        for p in glob.glob(pat):
            try:
                if os.path.getmtime(p) >= cutoff:
                    hits.add(os.path.realpath(p))
            except OSError:
                pass
    for p in sorted(hits):
        if not dry:
            try:
                os.remove(p)
            except OSError as e:
                print(f"Warning: could not delete {p}: {e}", file=sys.stderr)
                continue
        print(("would delete " if dry else "deleted ") + p)
    print(f"{'Would delete' if dry else 'Deleted'} {len(hits)} screenshot(s) modified in the last {since}.")


def cmd_js(client, args):
    """Execute JavaScript in page."""
    if len(args) < 2:
        print("Usage: chrome js <tab_id> <code>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    code = " ".join(args[1:])
    result = get_result(client.send("javascript", tabId=tab_id, code=code))
    if result is not None:
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)


def cmd_djs(client, args):
    """Run JS via the CDP debugger in an isolated world: works on strict-CSP pages
    (Microsoft/Google sign-in) where `chrome js` fails with 'unsafe-eval'.

    Usage: chrome djs <tab_id> <code>   (code is a function BODY: use `return ...`)
    """
    if len(args) < 2:
        print("Usage: chrome djs <tab_id> <code>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    code = " ".join(args[1:])
    result = get_result(client.send("debugger_eval", tabId=tab_id, code=code))
    print(json.dumps(result, indent=2) if isinstance(result, (dict, list)) else result)


def cmd_upload(client, args):
    """Attach local file(s) to an <input type=file> — works on Trusted-Types pages (Gmail).

    Usage: chrome upload <tab_id> <css_selector|auto> <file> [file...]
    Runs through the CDP debugger in an isolated world (not page eval, so Trusted
    Types / CSP don't block it), builds File objects from base64, assigns them to the
    input via DataTransfer and fires input/change. 'auto' = last file input on the page.
    Keep files small (a few MB total); the payload travels through native messaging.
    """
    import base64, mimetypes
    if len(args) < 3:
        print("Usage: chrome upload <tab_id> <css_selector|auto> <file> [file...]", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    selector = args[1]
    files = []
    for f in args[2:]:
        path = os.path.expanduser(f)
        with open(path, "rb") as fh:
            files.append({"name": os.path.basename(path),
                          "type": mimetypes.guess_type(path)[0] or "application/octet-stream",
                          "b64": base64.b64encode(fh.read()).decode()})
    code = (
        "const files = " + json.dumps(files) + ";"
        "const sel = " + json.dumps(selector) + ";"
        "const inputs = Array.from(document.querySelectorAll('input[type=file]'));"
        "const el = sel === 'auto' ? inputs[inputs.length - 1] : document.querySelector(sel);"
        "if (!el) return {ok: false, error: 'no file input found', count: inputs.length};"
        "const dt = new DataTransfer();"
        "for (const f of files) {"
        "  const bin = atob(f.b64); const u8 = new Uint8Array(bin.length);"
        "  for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);"
        "  dt.items.add(new File([u8], f.name, {type: f.type}));"
        "}"
        "el.files = dt.files;"
        "el.dispatchEvent(new Event('input', {bubbles: true}));"
        "el.dispatchEvent(new Event('change', {bubbles: true}));"
        "return {ok: true, attached: files.map(f => f.name), inputs: inputs.length};"
    )
    result = get_result(client.send("debugger_eval", tabId=tab_id, code=code))
    print(json.dumps(result, indent=2) if isinstance(result, (dict, list)) else result)


def cmd_js_all_frames(client, args):
    """Execute JavaScript in ALL frames (including cross-origin iframes)."""
    if len(args) < 2:
        print("Usage: chrome js-all-frames <tab_id> <code>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    code = " ".join(args[1:])
    result = get_result(client.send("eval_all_frames", tabId=tab_id, code=code))
    if result is not None:
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)


def cmd_cookies(client, args):
    """Get all cookies for a domain (including HttpOnly)."""
    if len(args) < 1:
        print("Usage: chrome cookies <domain>", file=sys.stderr)
        sys.exit(1)
    domain = args[0]
    # Ensure domain starts with .
    if not domain.startswith("."):
        domain = "." + domain
    result = get_result(client.send("get_cookies", domain=domain))
    if result is not None:
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)


def cmd_console(client, args):
    """Read console messages."""
    if len(args) < 1:
        print("Usage: chrome console <tab_id> [pattern] [--clear]", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    pattern = args[1] if len(args) > 1 and not args[1].startswith("--") else None
    clear = "--clear" in args
    result = get_result(client.send("read_console", tabId=tab_id, pattern=pattern, clear=clear))
    messages = result.get("messages", [])
    for msg in messages:
        print(f"[{msg.get('level', 'log')}] {msg.get('text', msg)}")


def cmd_network(client, args):
    """Read network requests."""
    if len(args) < 1:
        print("Usage: chrome network <tab_id> [url_pattern] [--clear]", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    pattern = args[1] if len(args) > 1 and not args[1].startswith("--") else None
    clear = "--clear" in args
    result = get_result(client.send("read_network", tabId=tab_id, urlPattern=pattern, clear=clear))
    requests = result.get("requests", [])
    for req in requests:
        status = req.get("status", "")
        method = req.get("method", "GET")
        url = req.get("url", "")[:80]
        print(f"{status:4} {method:6} {url}")


def cmd_ping(client, args):
    """Test connection to extension."""
    result = get_result(client.send("ping"))
    if result.get("pong"):
        print("Connected to Chrome Control extension")
    else:
        print("Unexpected response", file=sys.stderr)
        sys.exit(1)


def cmd_reset(client, args):
    """Kill stuck native_host.py processes without racing the SW's respawn.

    Use when `chrome ping` hangs or commands time out: typically means the
    Chrome extension's MV3 service worker was evicted while the native host
    had a half-frame buffered, leaving the host pegged at 100% CPU.

    The SW's onDisconnect handler respawns a fresh native_host as soon as
    we kill the old one, so this routine:
      1. Wipes the registry first (so the CLI can't see stale entries).
      2. SIGKILLs all current native_host pids.
      3. Sleeps briefly for the kernel to release sockets / SW to respawn.
      4. Re-pgreps to find any host the SW already brought back up.
      5. Unlinks only socket files that are NOT held by a live host.
    """
    # 1. Delete registry first so CLI doesn't see stale entries
    try:
        Path(REGISTRY_PATH).unlink()
    except FileNotFoundError:
        pass

    # 2. Find and SIGKILL all current native_host processes
    try:
        out = subprocess.check_output(
            ["pgrep", "-u", str(os.getuid()), "-f", "chrome-control/scripts/native_host"],
            text=True,
        ).strip()
        old_pids = [int(p) for p in out.splitlines() if p.strip()]
    except subprocess.CalledProcessError:
        old_pids = []

    for pid in old_pids:
        try:
            os.kill(pid, 9)  # SIGKILL — no grace
        except (ProcessLookupError, PermissionError):
            pass

    # 3. Wait for kernel to release sockets and for SW's onDisconnect to fire
    import time as _t
    _t.sleep(0.5)

    # 4. Re-pgrep — SW may have already respawned a new native_host during the sleep
    try:
        out = subprocess.check_output(
            ["pgrep", "-u", str(os.getuid()), "-f", "chrome-control/scripts/native_host"],
            text=True,
        ).strip()
        live_pids = [int(p) for p in out.splitlines() if p.strip()]
    except subprocess.CalledProcessError:
        live_pids = []

    # 5. Determine which sockets are owned by LIVE native_hosts via lsof
    live_socks = set()
    for pid in live_pids:
        try:
            lsof_out = subprocess.check_output(
                ["lsof", "-p", str(pid), "-Fn"],
                text=True, stderr=subprocess.DEVNULL,
            )
            for line in lsof_out.splitlines():
                if line.startswith("n") and "chrome_control_" in line and line.endswith(".sock"):
                    live_socks.add(line[1:])  # strip leading 'n' from -Fn output
        except subprocess.CalledProcessError:
            pass

    # 6. Unlink only orphaned socket files (not owned by any live host)
    socket_count = 0
    for sock_path in Path("/tmp").glob("chrome_control_*.sock"):
        if str(sock_path) in live_socks:
            continue
        try:
            sock_path.unlink()
            socket_count += 1
        except FileNotFoundError:
            pass

    print(f"Killed {len(old_pids)} native_host process(es), removed {socket_count} orphan socket(s).")
    if live_pids:
        print(f"{len(live_pids)} fresh native_host(s) already spawned by SW — preserved their sockets.")
        print("Run any chrome command to verify connectivity.")
        return

    # No live host means the service worker isn't running (it was the one that
    # would have respawned a host). Wake it ourselves — no toolbar click needed.
    print("No live native_host after kill — waking the service worker...")
    cmd_wake(None, args)


def cmd_wake(client, args):
    """Revive an evicted MV3 service worker — the no-hands version of clicking
    the extension's toolbar icon.

    Loading any of the extension's own pages forces Chrome to start its service
    worker, which reconnects the native host. We open a throwaway tab on the
    extension's popup page, wait for the host to re-register, then close it.
    """
    import time as _t

    if get_profiles():
        print("Already connected — service worker is alive.")
        return

    ext_id = extension_id()
    if not ext_id:
        print("Could not determine the extension ID.", file=sys.stderr)
        print(f"Expected native-host manifest at: {NATIVE_HOST_MANIFEST}", file=sys.stderr)
        print("Reload the extension once at chrome://extensions/ to recover.", file=sys.stderr)
        sys.exit(1)

    wake_url = f"chrome-extension://{ext_id}/popup.html"
    # `open -g`: don't raise the Chrome window; launches Chrome if it isn't running.
    subprocess.run(
        ["open", "-g", "-a", "Google Chrome", wake_url],
        check=False, capture_output=True,
    )

    deadline = _t.time() + 15
    while _t.time() < deadline:
        _t.sleep(0.5)
        if get_profiles():
            break
    else:
        # Worker didn't come back. Confirm the cause precisely so escalation is
        # specific, not "X is broken".
        print("Service worker did not come back within 15s.", file=sys.stderr)
        prefs = extension_prefs_state(ext_id)
        if prefs.get("found") and not prefs.get("enabled"):
            reasons = prefs.get("reasons") or []
            why = f" ({'; '.join(reasons)})" if reasons else ""
            print(
                f"Confirmed: Chrome has the chrome-control extension DISABLED/errored{why}.",
                file=sys.stderr,
            )
            print(
                "Automated fix: run ~/dispatch/scripts/chrome-heal — it presses "
                "the reload ⟳ on chrome://extensions/ via the Accessibility API "
                "(must run in an AX-trusted context, e.g. as a daemon script "
                "task; the daemon's chrome_control check also does this "
                "automatically). Manual fallback: open chrome://extensions/, "
                "turn on Developer mode, find \"Chrome Control\", and click the "
                "reload ⟳ icon (or toggle it off and back on).",
                file=sys.stderr,
            )
        elif prefs.get("found") and prefs.get("enabled"):
            print(
                "Chrome's Preferences say the extension is still ENABLED — so "
                "this isn't the usual 'errored extension' case. Chrome's "
                "service-worker subsystem may be wedged. Try fully quitting and "
                "reopening Google Chrome; if it still won't connect, then reload "
                "the extension at chrome://extensions/ (Developer mode → reload ⟳).",
                file=sys.stderr,
            )
        else:
            # Couldn't read Default-profile Preferences, or the extension lives
            # in a non-Default profile.
            print(
                "Could not confirm the extension's state from the Default "
                "profile's Preferences (it may be loaded in a different Chrome "
                "profile). Best bet: reload \"Chrome Control\" once at "
                "chrome://extensions/ (Developer mode → reload ⟳); if that "
                "doesn't help, fully restart Google Chrome.",
                file=sys.stderr,
            )
        sys.exit(1)

    # DO NOT close the wake tab. It is not a leak — it is the life support.
    #
    # An MV3 service worker stays alive while one of the extension's own pages
    # is open. This function used to close the tab here and then print success,
    # on the assumption that "connectivity is restored regardless". That
    # assumption is false: closing the wake page evicts the worker within
    # milliseconds, so wake verified connectivity, destroyed it, and then
    # announced it.
    #
    # Measured 2026-08-27 in /tmp/chrome_control.log: 2,242 of 2,269
    # `Extension disconnected` events land within 3 lines of a `close_tab`.
    # A peer box with no wake command has 150 close_tabs and 0 worker kills —
    # so it is not close_tab that is dangerous, it is closing THIS page.
    #
    # The verification above is real, but it ran before the destructive step.
    # Re-verify after, and let the exit code be the verifier's.
    still_up = get_profiles()
    if not still_up:
        print(
            "Wake page loaded and the worker started, but connectivity was lost "
            "again immediately — something closed the extension page.",
            file=sys.stderr,
        )
        sys.exit(1)

    print("Service worker revived — chrome-control is connected.")
    print(f"Left a background tab open on {wake_url} — it is what keeps the "
          "MV3 worker alive. Closing it will drop the connection.")


def cmd_reload_extension(client, args):
    """Tell Chrome to reload the unpacked extension (picks up background.js
    changes). The worker restarts, the native host drops and respawns, and the
    new code is live — no chrome://extensions/ visit needed.

    Note: the *currently running* worker must already understand the reload
    signal (it has since the `type: 'reload'` handler was added). If you're
    upgrading from a build that predates it, reload once by hand first.
    """
    import time as _t

    get_result(client.send("_reload_extension", timeout=10))
    print("Reload signal sent — extension is restarting...")

    # The reload drops the native host; the worker should restart and reconnect
    # on its own. Give it a few seconds, then wake it explicitly if it didn't.
    deadline = _t.time() + 8
    while _t.time() < deadline:
        _t.sleep(0.5)
        if get_profiles():
            print("Extension reloaded and reconnected.")
            return
    print("Worker hasn't reconnected yet — waking it...")
    cmd_wake(None, args)


def cmd_profiles(client, args):
    """List available Chrome profiles."""
    profiles = get_profiles()
    if not profiles:
        print("No Chrome profiles connected")
        print("Make sure Chrome is running with the extension loaded")
        return
    print(f"Available profiles ({len(profiles)}):")
    for i, p in enumerate(profiles):
        print(f"  {i}: {p['name']}")


def cmd_profile_info(client, args):
    """Get detailed profile info from Chrome identity API."""
    result = get_result(client.send("profile_info"))
    print(f"Email: {result.get('email', 'not available')}")
    print(f"ID: {result.get('id', 'not available')}")
    print(f"Extension ID: {result.get('extensionId', 'unknown')}")
    if result.get('error'):
        print(f"Error: {result.get('error')}")


COMMANDS = {
    "profiles": None,  # Special case - handled before client creation
    "profile-info": cmd_profile_info,
    "tabs": cmd_tabs,
    "open": cmd_open,
    "close": cmd_close,
    "focus": cmd_focus,
    "navigate": cmd_navigate,
    "nav": cmd_navigate,
    "read": cmd_read,
    "text": cmd_text,
    "html": cmd_html,
    "find": cmd_find,
    "click": cmd_click,
    "click-at": cmd_click_at,
    "type": cmd_type,
    "input": cmd_input,
    "key": cmd_key,
    "insert-text": cmd_insert_text,
    "iframe-click": cmd_iframe_click,
    "iframe-type": cmd_iframe_type,
    "iframe-eval": cmd_iframe_eval,
    "scroll": cmd_scroll,
    "hover": cmd_hover,
    "screenshot": cmd_screenshot,
    "shot": cmd_screenshot,
    "shot-purge": None,  # Special case - no client needed
    "os-type": cmd_os_type,
    "js": cmd_js,
    "upload": cmd_upload,
    "djs": cmd_djs,
    "js-all-frames": cmd_js_all_frames,
    "fetch": cmd_fetch,
    "cookies": cmd_cookies,
    "console": cmd_console,
    "network": cmd_network,
    "ping": cmd_ping,
    "click-by-name": cmd_click_by_name,
    "reset": None,  # Special case - handled before client creation
    "wake": None,   # Special case - runs even when no worker/host is up
    "reload-extension": cmd_reload_extension,
    "reload-ext": cmd_reload_extension,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0)

    # Parse profile flag
    profile_selector = None
    args = sys.argv[1:]

    if args and args[0] in ("-p", "--profile"):
        if len(args) < 2:
            print("Error: --profile requires an argument", file=sys.stderr)
            sys.exit(1)
        profile_selector = args[1]
        args = args[2:]

    if not args:
        print(__doc__)
        sys.exit(0)

    command = args[0]
    cmd_args = args[1:]

    # Handle profiles command (no client needed)
    if command == "profiles":
        cmd_profiles(None, cmd_args)
        return

    # Handle reset command (no client needed; runs even when host is wedged)
    if command == "reset":
        cmd_reset(None, cmd_args)
        return

    # Handle shot-purge (pure filesystem; works with Chrome down)
    if command == "shot-purge":
        cmd_shot_purge(None, cmd_args)
        return

    if command == "os-type" and (not cmd_args or cmd_args[0] in ("-h", "--help")):
        cmd_os_type(None, cmd_args)
        return

    # Handle wake command (no client needed; runs when the worker is evicted)
    if command == "wake":
        cmd_wake(None, cmd_args)
        return

    if command not in COMMANDS:
        print(f"Unknown command: {command}", file=sys.stderr)
        print("Run 'chrome --help' for usage", file=sys.stderr)
        sys.exit(1)

    try:
        socket_path = find_profile_socket(profile_selector)
        client = ChromeControl(socket_path)
        COMMANDS[command](client, cmd_args)
    except ConnectionRefusedError:
        print("Error: Cannot connect to Chrome Control extension", file=sys.stderr)
        print("Make sure Chrome is running with the extension loaded", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        print("Error: Chrome profile socket not found", file=sys.stderr)
        print("The profile may have disconnected. Run 'chrome profiles' to check.", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
