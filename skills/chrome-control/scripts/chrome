    get_result(client.send("form_input", tabId=tab_id, ref=ref, value=value))
    print(f"Set {ref} = {value}")


def cmd_key(client, args):
    """Send key press."""
    if len(args) < 2:
        print("Usage: chrome key <tab_id> <key> [modifiers]", file=sys.stderr)
        print("  Keys: Enter, Tab, Escape, Backspace, ArrowUp, ArrowDown, etc.", file=sys.stderr)
        print("  Modifiers: ctrl, alt, shift, meta (comma-separated)", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    key = args[1]
    modifiers = args[2].split(",") if len(args) > 2 else None
    get_result(client.send("key", tabId=tab_id, key=key, modifiers=modifiers))
    print(f"Sent key: {key}")


def cmd_insert_text(client, args):
    """Insert text at current focus (works in iframes)."""
    if len(args) < 2:
        print("Usage: chrome insert-text <tab_id> <text>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    text = " ".join(args[1:])
    get_result(client.send("insert_text", tabId=tab_id, text=text))
    print(f"Inserted text")


def cmd_iframe_click(client, args):
    """Click element inside iframe by CSS selector."""
    if len(args) < 2:
        print("Usage: chrome iframe-click <tab_id> <selector>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    selector = " ".join(args[1:])
    result = get_result(client.send("iframe_click", tabId=tab_id, selector=selector))
    print(f"Result: {result.get('result', result)}")


def cmd_click_by_name(client, args):
    """Click element by accessible name using Chrome accessibility tree."""
    if len(args) < 2:
        print("Usage: chrome click-by-name <tab_id> <name> [--role <role>] [--index <n>]", file=sys.stderr)
        print("  Uses Chrome's accessibility tree to find elements.", file=sys.stderr)
        print("  Bypasses CSP restrictions.", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])

    # Parse args
    name = args[1]
    role = None
    index = 0
    i = 2
    while i < len(args):
        if args[i] == "--role" and i + 1 < len(args):
            role = args[i + 1]
            i += 2
        elif args[i] == "--index" and i + 1 < len(args):
            index = int(args[i + 1])
            i += 2
        else:
            # Append to name if not a flag
            name += " " + args[i]
            i += 1

    params = {"tabId": tab_id, "name": name, "index": index}
    if role:
        params["role"] = role

    result = get_result(client.send("click_by_name", **params))
    if result.get("clicked"):
        print(f"Clicked element: {result.get('name', name)} (role: {result.get('role', 'unknown')})")
    else:
        print(f"Could not find element with name '{name}'", file=sys.stderr)
        if result.get("matchesFound"):
            print(f"  Found {result.get('matchesFound')} partial matches", file=sys.stderr)
        sys.exit(1)


def cmd_iframe_type(client, args):
    """Type text using debugger key events (works for iframes)."""
    if len(args) < 2:
        print("Usage: chrome iframe-type <tab_id> <text>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    text = " ".join(args[1:])
    result = get_result(client.send("iframe_type", tabId=tab_id, text=text))
    print(f"Typed: {result}")


def cmd_iframe_eval(client, args):
    """Execute JS inside a cross-origin iframe via Chrome debugger Target API."""
    if len(args) < 3:
        print("Usage: chrome iframe-eval <tab_id> <url_pattern> <code>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    url_pattern = args[1]
    code = " ".join(args[2:])
    result = get_result(client.send("iframe_target_eval", tabId=tab_id, urlPattern=url_pattern, code=code))
    if result is not None:
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)


def cmd_scroll(client, args):
    """Scroll the page."""
    if len(args) < 2:
        print("Usage: chrome scroll <tab_id> <direction> [amount]", file=sys.stderr)
        print("  Directions: up, down, left, right", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    direction = args[1]
    amount = int(args[2]) if len(args) > 2 else 3
    get_result(client.send("scroll", tabId=tab_id, direction=direction, amount=amount))
    print(f"Scrolled {direction}")


def cmd_hover(client, args):
    """Hover at coordinates."""
    if len(args) < 3:
        print("Usage: chrome hover <tab_id> <x> <y>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    x, y = int(args[1]), int(args[2])
    get_result(client.send("hover", tabId=tab_id, x=x, y=y))
    print(f"Hovering at ({x}, {y})")


def cmd_screenshot(client, args):
    """Take screenshot and save to ~/Pictures."""
    if len(args) < 1:
        print("Usage: chrome screenshot <tab_id>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    result = get_result(client.send("screenshot", timeout=120, tabId=tab_id))

    # Get source path
    src_path = result.get("screenshotPath")
    if not src_path:
        print("Error: No screenshot path returned", file=sys.stderr)
        sys.exit(1)

    # Create destination directory
    PICTURES_DIR.mkdir(parents=True, exist_ok=True)

    # Generate filename with timestamp
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    dest_path = PICTURES_DIR / f"screenshot_{timestamp}.jpg"

    # Copy file
    shutil.copy2(src_path, dest_path)

    # Resize if too large (prevents buffer overflow when Claude reads it)
    # Target: max 1600px on longest side (keeps ~800KB file size, well under 1MB SDK limit)
    try:
        result = subprocess.run(
            ["sips", "-g", "pixelWidth", "-g", "pixelHeight", str(dest_path)],
            capture_output=True, text=True, timeout=5,
        )
        width = height = 0
        for line in result.stdout.splitlines():
            if "pixelWidth" in line:
                width = int(line.split(":")[-1].strip())
            elif "pixelHeight" in line:
                height = int(line.split(":")[-1].strip())

        MAX_DIM = 1600
        if width > MAX_DIM or height > MAX_DIM:
            subprocess.run(
                ["sips", "--resampleHeightWidthMax", str(MAX_DIM), str(dest_path)],
                capture_output=True, timeout=10,
            )
    except Exception:
        pass  # If resize fails, still return the original

    # Print the path (this is what the user sees)
    print(dest_path)


def cmd_js(client, args):
    """Execute JavaScript in page."""
    if len(args) < 2:
        print("Usage: chrome js <tab_id> <code>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    code = " ".join(args[1:])
    result = get_result(client.send("javascript", tabId=tab_id, code=code))
    if result is not None:
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)


def cmd_js_all_frames(client, args):
    """Execute JavaScript in ALL frames (including cross-origin iframes)."""
    if len(args) < 2:
        print("Usage: chrome js-all-frames <tab_id> <code>", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    code = " ".join(args[1:])
    result = get_result(client.send("eval_all_frames", tabId=tab_id, code=code))
    if result is not None:
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)


def cmd_cookies(client, args):
    """Get all cookies for a domain (including HttpOnly)."""
    if len(args) < 1:
        print("Usage: chrome cookies <domain>", file=sys.stderr)
        sys.exit(1)
    domain = args[0]
    # Ensure domain starts with .
    if not domain.startswith("."):
        domain = "." + domain
    result = get_result(client.send("get_cookies", domain=domain))
    if result is not None:
        if isinstance(result, (dict, list)):
            print(json.dumps(result, indent=2))
        else:
            print(result)


def cmd_console(client, args):
    """Read console messages."""
    if len(args) < 1:
        print("Usage: chrome console <tab_id> [pattern] [--clear]", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    pattern = args[1] if len(args) > 1 and not args[1].startswith("--") else None
    clear = "--clear" in args
    result = get_result(client.send("read_console", tabId=tab_id, pattern=pattern, clear=clear))
    messages = result.get("messages", [])
    for msg in messages:
        print(f"[{msg.get('level', 'log')}] {msg.get('text', msg)}")


def cmd_network(client, args):
    """Read network requests."""
    if len(args) < 1:
        print("Usage: chrome network <tab_id> [url_pattern] [--clear]", file=sys.stderr)
        sys.exit(1)
    tab_id = parse_tab_id(args[0])
    pattern = args[1] if len(args) > 1 and not args[1].startswith("--") else None
    clear = "--clear" in args
    result = get_result(client.send("read_network", tabId=tab_id, urlPattern=pattern, clear=clear))
    requests = result.get("requests", [])
    for req in requests:
        status = req.get("status", "")
        method = req.get("method", "GET")
        url = req.get("url", "")[:80]
        print(f"{status:4} {method:6} {url}")


def cmd_ping(client, args):
    """Test connection to extension."""
    result = get_result(client.send("ping"))
    if result.get("pong"):
        print("Connected to Chrome Control extension")
    else:
        print("Unexpected response", file=sys.stderr)
        sys.exit(1)


def cmd_reset(client, args):
    """Kill stuck native_host.py processes without racing the SW's respawn.

    Use when `chrome ping` hangs or commands time out: typically means the
    Chrome extension's MV3 service worker was evicted while the native host
    had a half-frame buffered, leaving the host pegged at 100% CPU.

    The SW's onDisconnect handler respawns a fresh native_host as soon as
    we kill the old one, so this routine:
      1. Wipes the registry first (so the CLI can't see stale entries).
      2. SIGKILLs all current native_host pids.
      3. Sleeps briefly for the kernel to release sockets / SW to respawn.
      4. Re-pgreps to find any host the SW already brought back up.
      5. Unlinks only socket files that are NOT held by a live host.
    """
    # 1. Delete registry first so CLI doesn't see stale entries
    try:
        Path(REGISTRY_PATH).unlink()
    except FileNotFoundError:
        pass

    # 2. Find and SIGKILL all current native_host processes
    try:
        out = subprocess.check_output(
            ["pgrep", "-u", str(os.getuid()), "-f", "chrome-control/scripts/native_host"],
            text=True,
        ).strip()
        old_pids = [int(p) for p in out.splitlines() if p.strip()]
    except subprocess.CalledProcessError:
        old_pids = []

    for pid in old_pids:
        try:
            os.kill(pid, 9)  # SIGKILL — no grace
        except (ProcessLookupError, PermissionError):
            pass

    # 3. Wait for kernel to release sockets and for SW's onDisconnect to fire
    import time as _t
    _t.sleep(0.5)

    # 4. Re-pgrep — SW may have already respawned a new native_host during the sleep
    try:
        out = subprocess.check_output(
            ["pgrep", "-u", str(os.getuid()), "-f", "chrome-control/scripts/native_host"],
            text=True,
        ).strip()
        live_pids = [int(p) for p in out.splitlines() if p.strip()]
    except subprocess.CalledProcessError:
        live_pids = []

    # 5. Determine which sockets are owned by LIVE native_hosts via lsof
    live_socks = set()
    for pid in live_pids:
        try:
            lsof_out = subprocess.check_output(
                ["lsof", "-p", str(pid), "-Fn"],
                text=True, stderr=subprocess.DEVNULL,
            )
            for line in lsof_out.splitlines():
                if line.startswith("n") and "chrome_control_" in line and line.endswith(".sock"):
                    live_socks.add(line[1:])  # strip leading 'n' from -Fn output
        except subprocess.CalledProcessError:
            pass

    # 6. Unlink only orphaned socket files (not owned by any live host)
    socket_count = 0
    for sock_path in Path("/tmp").glob("chrome_control_*.sock"):
        if str(sock_path) in live_socks:
            continue
        try:
            sock_path.unlink()
            socket_count += 1
        except FileNotFoundError:
            pass

    print(f"Killed {len(old_pids)} native_host process(es), removed {socket_count} orphan socket(s).")
    if live_pids:
        print(f"{len(live_pids)} fresh native_host(s) already spawned by SW — preserved their sockets.")
        print("Run any chrome command to verify connectivity.")
        return

    # No live host means the service worker isn't running (it was the one that
    # would have respawned a host). Wake it ourselves — no toolbar click needed.
    print("No live native_host after kill — waking the service worker...")
    cmd_wake(None, args)


def cmd_wake(client, args):
    """Revive an evicted MV3 service worker — the no-hands version of clicking
    the extension's toolbar icon.

    Loading any of the extension's own pages forces Chrome to start its service
    worker, which reconnects the native host. We open a throwaway tab on the
    extension's popup page, wait for the host to re-register, then close it.
    """
    import time as _t

    if get_profiles():
        print("Already connected — service worker is alive.")
        return

    ext_id = extension_id()
    if not ext_id:
        print("Could not determine the extension ID.", file=sys.stderr)
        print(f"Expected native-host manifest at: {NATIVE_HOST_MANIFEST}", file=sys.stderr)
        print("Reload the extension once at chrome://extensions/ to recover.", file=sys.stderr)
        sys.exit(1)

    wake_url = f"chrome-extension://{ext_id}/popup.html"
    # `open -g`: don't raise the Chrome window; launches Chrome if it isn't running.
    subprocess.run(
        ["open", "-g", "-a", "Google Chrome", wake_url],
        check=False, capture_output=True,
    )

    deadline = _t.time() + 15
    while _t.time() < deadline:
        _t.sleep(0.5)
        if get_profiles():
            break
    else:
        # Worker didn't come back. Confirm the cause precisely so escalation is
        # specific, not "X is broken".
        print("Service worker did not come back within 15s.", file=sys.stderr)
        prefs = extension_prefs_state(ext_id)
        if prefs.get("found") and not prefs.get("enabled"):
            reasons = prefs.get("reasons") or []
            why = f" ({'; '.join(reasons)})" if reasons else ""
            print(
                f"Confirmed: Chrome has the chrome-control extension DISABLED/errored{why}.",
                file=sys.stderr,
            )
            print(
                "Automated fix: run ~/dispatch/scripts/chrome-heal — it presses "
                "the reload ⟳ on chrome://extensions/ via the Accessibility API "
                "(must run in an AX-trusted context, e.g. as a daemon script "
                "task; the daemon's chrome_control check also does this "
                "automatically). Manual fallback: open chrome://extensions/, "
                "turn on Developer mode, find \"Chrome Control\", and click the "
                "reload ⟳ icon (or toggle it off and back on).",
                file=sys.stderr,
            )
        elif prefs.get("found") and prefs.get("enabled"):
            print(
                "Chrome's Preferences say the extension is still ENABLED — so "
                "this isn't the usual 'errored extension' case. Chrome's "
                "service-worker subsystem may be wedged. Try fully quitting and "
                "reopening Google Chrome; if it still won't connect, then reload "
                "the extension at chrome://extensions/ (Developer mode → reload ⟳).",
                file=sys.stderr,
            )
        else:
            # Couldn't read Default-profile Preferences, or the extension lives
            # in a non-Default profile.
            print(
                "Could not confirm the extension's state from the Default "
                "profile's Preferences (it may be loaded in a different Chrome "
                "profile). Best bet: reload \"Chrome Control\" once at "
                "chrome://extensions/ (Developer mode → reload ⟳); if that "
                "doesn't help, fully restart Google Chrome.",
                file=sys.stderr,
            )
        sys.exit(1)

    # Close the throwaway wake tab(s) so we don't leak them.
    try:
        socket_path = find_profile_socket(None)
        c = ChromeControl(socket_path)
        tabs = (get_result(c.send("list_tabs")) or {}).get("tabs", [])
        for tab in tabs:
            if str(tab.get("url", "")).startswith(wake_url):
                c.send("close_tab", tabId=tab["id"])
    except Exception:
        pass  # best-effort cleanup; connectivity is restored regardless

    print("Service worker revived — chrome-control is connected.")


def cmd_reload_extension(client, args):
    """Tell Chrome to reload the unpacked extension (picks up background.js
    changes). The worker restarts, the native host drops and respawns, and the
    new code is live — no chrome://extensions/ visit needed.

    Note: the *currently running* worker must already understand the reload
    signal (it has since the `type: 'reload'` handler was added). If you're
    upgrading from a build that predates it, reload once by hand first.
    """
    import time as _t

    get_result(client.send("_reload_extension", timeout=10))
    print("Reload signal sent — extension is restarting...")

    # The reload drops the native host; the worker should restart and reconnect
    # on its own. Give it a few seconds, then wake it explicitly if it didn't.
    deadline = _t.time() + 8
    while _t.time() < deadline:
        _t.sleep(0.5)
        if get_profiles():
            print("Extension reloaded and reconnected.")
            return
    print("Worker hasn't reconnected yet — waking it...")
    cmd_wake(None, args)


def cmd_profiles(client, args):
    """List available Chrome profiles."""
    profiles = get_profiles()
    if not profiles:
        print("No Chrome profiles connected")
        print("Make sure Chrome is running with the extension loaded")
        return
    print(f"Available profiles ({len(profiles)}):")
    for i, p in enumerate(profiles):
        print(f"  {i}: {p['name']}")


def cmd_profile_info(client, args):
    """Get detailed profile info from Chrome identity API."""
    result = get_result(client.send("profile_info"))
    print(f"Email: {result.get('email', 'not available')}")
    print(f"ID: {result.get('id', 'not available')}")
    print(f"Extension ID: {result.get('extensionId', 'unknown')}")
    if result.get('error'):
        print(f"Error: {result.get('error')}")


COMMANDS = {
    "profiles": None,  # Special case - handled before client creation
    "profile-info": cmd_profile_info,
    "tabs": cmd_tabs,
    "open": cmd_open,
    "close": cmd_close,
    "focus": cmd_focus,
    "navigate": cmd_navigate,
    "nav": cmd_navigate,
    "read": cmd_read,
    "text": cmd_text,
    "html": cmd_html,
    "find": cmd_find,
    "click": cmd_click,
    "click-at": cmd_click_at,
    "type": cmd_type,
    "input": cmd_input,
    "key": cmd_key,
    "insert-text": cmd_insert_text,
    "iframe-click": cmd_iframe_click,
    "iframe-type": cmd_iframe_type,
    "iframe-eval": cmd_iframe_eval,
    "scroll": cmd_scroll,
    "hover": cmd_hover,
    "screenshot": cmd_screenshot,
    "shot": cmd_screenshot,
    "js": cmd_js,
    "js-all-frames": cmd_js_all_frames,
    "cookies": cmd_cookies,
    "console": cmd_console,
    "network": cmd_network,
    "ping": cmd_ping,
    "click-by-name": cmd_click_by_name,
    "reset": None,  # Special case - handled before client creation
    "wake": None,   # Special case - runs even when no worker/host is up
    "reload-extension": cmd_reload_extension,
    "reload-ext": cmd_reload_extension,
}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        sys.exit(0)

    # Parse profile flag
    profile_selector = None
    args = sys.argv[1:]

    if args and args[0] in ("-p", "--profile"):
        if len(args) < 2:
            print("Error: --profile requires an argument", file=sys.stderr)
            sys.exit(1)
        profile_selector = args[1]
        args = args[2:]

    if not args:
        print(__doc__)
        sys.exit(0)

    command = args[0]
    cmd_args = args[1:]

    # Handle profiles command (no client needed)
    if command == "profiles":
        cmd_profiles(None, cmd_args)
        return

    # Handle reset command (no client needed; runs even when host is wedged)
    if command == "reset":
        cmd_reset(None, cmd_args)
        return

    # Handle wake command (no client needed; runs when the worker is evicted)
    if command == "wake":
        cmd_wake(None, cmd_args)
        return

    if command not in COMMANDS:
        print(f"Unknown command: {command}", file=sys.stderr)
        print("Run 'chrome --help' for usage", file=sys.stderr)
        sys.exit(1)

    try:
        socket_path = find_profile_socket(profile_selector)
        client = ChromeControl(socket_path)
        COMMANDS[command](client, cmd_args)
    except ConnectionRefusedError:
        print("Error: Cannot connect to Chrome Control extension", file=sys.stderr)
        print("Make sure Chrome is running with the extension loaded", file=sys.stderr)
        sys.exit(1)
    except FileNotFoundError:
        print("Error: Chrome profile socket not found", file=sys.stderr)
        print("The profile may have disconnected. Run 'chrome profiles' to check.", file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
