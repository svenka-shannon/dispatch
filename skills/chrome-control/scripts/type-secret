#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""type-secret <tab_id> <keychain-service> [--account ACCT] [--click SELECTOR]

Reads a secret (e.g. a password) from the macOS Keychain INSIDE this process and inserts it
at the focused field of a Chrome tab via chrome-control's `insert_text`. The secret never
appears in argv, shell history, or output. Use this instead of
`chrome insert-text <tab> "$(security find-generic-password ... -w)"`, which leaks the secret
into the process list.

  --click SELECTOR   click this element first (uses iframe_click, works in iframes)
  --exec             insert at the current caret with document.execCommand('insertText') via the
                     CDP debugger (works in contenteditable editors like Gmail compose, where
                     insert_text/type silently do nothing). Put the caret there first with `chrome djs`.
  --into SELECTOR    type into this element via chrome-control `type` (most reliable on
                     normal pages; insert_text at focus can silently land nowhere)

Example (Amazon sign-in):
  type-secret 123 amazon-eric --account owner@example.com --into '#ap_password'
"""
import argparse, importlib.machinery, importlib.util, signal, subprocess, sys
from pathlib import Path


def main():
    ap = argparse.ArgumentParser(usage=__doc__)
    ap.add_argument("tab", type=int)
    ap.add_argument("service")
    ap.add_argument("--account")
    ap.add_argument("--click")
    ap.add_argument("--into")
    ap.add_argument("--exec", action="store_true")
    a = ap.parse_args()

    cmd = ["security", "find-generic-password", "-s", a.service, "-w"]
    if a.account:
        cmd[2:2] = ["-a", a.account]
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        sys.exit(f"keychain item not found: service={a.service} account={a.account}")
    secret = r.stdout.rstrip("\n")

    src = Path.home() / ".claude/skills/chrome-control/scripts/chrome"
    ld = importlib.machinery.SourceFileLoader("chromecli", str(src))
    spec = importlib.util.spec_from_loader("chromecli", ld)
    m = importlib.util.module_from_spec(spec)
    sys.argv = ["chrome"]
    ld.exec_module(m)
    client = m.ChromeControl(m.find_profile_socket(None))
    signal.alarm(60)  # never hang
    if a.click:
        res = client.send("iframe_click", tabId=a.tab, selector=a.click)
        if isinstance(res, dict) and res.get("error"):
            sys.exit("click failed: " + str(res.get("error"))[:160])
    if a.exec:
        import json as _j
        code = ("const ok = document.execCommand('insertText', false, " + _j.dumps(secret) + ");"
                "return {ok};")
        res = client.send("debugger_eval", tabId=a.tab, code=code)
    elif a.into:
        res = client.send("type", tabId=a.tab, selector=a.into, text=secret)
    else:
        res = client.send("insert_text", tabId=a.tab, text=secret)
    if isinstance(res, dict) and res.get("error"):
        sys.exit("insert_text failed: " + str(res.get("error"))[:160])
    print("secret inserted (value not shown)")


if __name__ == "__main__":
    main()
