#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["sounddevice", "soundfile", "numpy", "kokoro-onnx", "claude-agent-sdk", "pocket-tts"]
# ///
"""
call - Place and conduct FaceTime Audio calls with TTS voice + whisper ears.

The agent speaks by playing TTS audio into a virtual mic (BlackHole 2ch =
FaceTime's input) and hears by recording FaceTime's output (BlackHole 16ch),
then transcribing with whisper.cpp.

Subcommands:
  doctor                      Check all prerequisites
  devices [--setup|--restore] Show / set / restore audio device routing
  start <target>              Place a FaceTime Audio call (phone or Apple ID email)
  say "text"                  Speak into the active call (TTS -> virtual mic)
  listen                      Record + transcribe what the other side says
  status                      Show call/audio state
  end                         Hang up, restore audio devices
  test-audio                  Loopback self-test of the full audio pipeline (no call)

Typical conversation loop (driven by the agent):
  call start "+15551234567"
  call listen --wait-for-speech --max 45     # wait for "Hello?"
  call say "Hi! This is Svenka, Eric's AI assistant..."
  call listen --wait-for-speech
  ... repeat say/listen ...
  call end
"""

import argparse
import hashlib
import json
import math
import os
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
MIC_DEVICE = "BlackHole 2ch"        # we play TTS here; FaceTime uses it as microphone
SPK_DEVICE = "BlackHole 16ch"       # FaceTime plays far-end audio here; we record it
STATE_DIR = Path("/tmp/phone-call")
STATE_FILE = STATE_DIR / "state.json"
AXCTL = HOME / ".claude/skills/axctl/scripts/axctl"
SWITCH = "/opt/homebrew/bin/SwitchAudioSource"
CLICLICK = "/opt/homebrew/bin/cliclick"
FFMPEG = "/opt/homebrew/bin/ffmpeg"
WHISPER_CLI = "/opt/homebrew/bin/whisper-cli"
WHISPER_MODEL = HOME / ".local/share/whisper/ggml-base.en.bin"
SPEAK_KOKORO = HOME / ".claude/skills/tts/scripts/speak"
SPEAK_QWEN = HOME / ".claude/skills/tts/scripts/speak-qwen"

RECORD_RATE = 16000  # record at whisper's native rate; CoreAudio resamples


def log(msg: str) -> None:
    print(msg, file=sys.stderr)


def die(msg: str, code: int = 1) -> None:
    print(f"ERROR: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd: list[str], timeout: int = 30, **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)


# ---------------------------------------------------------------- state

def load_state() -> dict:
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except json.JSONDecodeError:
            return {}
    return {}


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(state, indent=2))


# ---------------------------------------------------------------- audio devices

def list_audio_devices() -> list[str]:
    out = run([SWITCH, "-a"]).stdout
    return [line.strip() for line in out.splitlines() if line.strip()]


def current_device(kind: str) -> str:
    return run([SWITCH, "-c", "-t", kind]).stdout.strip()


def set_device(kind: str, name: str) -> bool:
    r = run([SWITCH, "-t", kind, "-s", name])
    return r.returncode == 0


def blackhole_installed() -> tuple[bool, bool]:
    devs = list_audio_devices()
    return (MIC_DEVICE in devs, SPK_DEVICE in devs)


def devices_setup() -> None:
    """Route FaceTime through the virtual devices, remembering prior defaults."""
    mic_ok, spk_ok = blackhole_installed()
    if not (mic_ok and spk_ok):
        die(
            f"virtual audio devices missing (need '{MIC_DEVICE}' and '{SPK_DEVICE}').\n"
            "Install with: brew install blackhole-2ch blackhole-16ch\n"
            "(requires an admin password; then: sudo killall coreaudiod)"
        )
    state = load_state()
    # Only save originals once per routing session (don't clobber on re-setup)
    if not state.get("routed"):
        state["saved_input"] = current_device("input")
        state["saved_output"] = current_device("output")
        state["saved_system"] = current_device("system")
        state["saved_volume"] = run(
            ["osascript", "-e", "get volume settings"]).stdout.strip()
    if not set_device("input", MIC_DEVICE):
        die(f"failed to set default input to {MIC_DEVICE}")
    if not set_device("output", SPK_DEVICE):
        die(f"failed to set default output to {SPK_DEVICE}")
    # Sound effects (incl. loud DTMF dial tones) use their own device — send
    # them into the virtual device too and zero the alert volume so nothing
    # blares from the real speakers while dialing.
    set_device("system", SPK_DEVICE)
    run(["osascript", "-e", "set volume alert volume 0"])
    # Call audio rides the system output path, so the output-volume setting
    # scales what lands in BlackHole — near-zero volume = whisper-level
    # capture (~-47dB). Max it out and unmute.
    run(["osascript", "-e", "set volume output volume 100"])
    run(["osascript", "-e", "set volume without output muted"])
    state["routed"] = True
    save_state(state)
    log(f"audio routed: input={MIC_DEVICE} output={SPK_DEVICE}")


def devices_restore() -> None:
    state = load_state()
    out = state.get("saved_output") or "Mac mini Speakers"
    inp = state.get("saved_input")
    sysdev = state.get("saved_system") or out
    if out in list_audio_devices():
        set_device("output", out)
        log(f"restored output -> {out}")
    if sysdev in list_audio_devices():
        set_device("system", sysdev)
    if inp and inp in list_audio_devices():
        set_device("input", inp)
        log(f"restored input -> {inp}")
    # Restore volumes ("output volume:44, input volume:80, alert volume:75,
    # output muted:false") so we don't leave the speakers at 100%.
    saved = state.get("saved_volume", "")
    try:
        parts = dict(p.split(":") for p in saved.split(", "))
        run(["osascript", "-e",
             f"set volume output volume {int(parts['output volume'])}"])
        run(["osascript", "-e",
             f"set volume alert volume {int(parts['alert volume'])}"])
        if parts.get("output muted") == "true":
            run(["osascript", "-e", "set volume with output muted"])
    except (ValueError, KeyError):
        run(["osascript", "-e", "set volume output volume 50"])
        run(["osascript", "-e", "set volume alert volume 75"])
    state["routed"] = False
    save_state(state)


# ---------------------------------------------------------------- UI driving

GRANTED_PY = HOME / ".local/share/uv/python/cpython-3.14.4-macos-aarch64-none/bin/python3.14"
# top-right region where the "click to call" notification banner appears
POPUP_REGION = (1300, 0, 620, 320)  # x, y, w, h in screen points


def capture_region_raw(out_path: Path) -> tuple[int, int] | None:
    """Capture POPUP_REGION as raw RGBA via the screen-recording-granted python.
    Returns (width, height) or None on failure."""
    x, y, w, h = POPUP_REGION
    code = f"""
import Quartz, sys
r = Quartz.CGRectMake({x}, {y}, {w}, {h})
img = Quartz.CGDisplayCreateImageForRect(Quartz.CGMainDisplayID(), r)
if img is None:
    sys.exit(3)
prov = Quartz.CGImageGetDataProvider(img)
data = Quartz.CGDataProviderCopyData(prov)
w2, h2 = Quartz.CGImageGetWidth(img), Quartz.CGImageGetHeight(img)
bpr = Quartz.CGImageGetBytesPerRow(img)
with open({str(out_path)!r}, "wb") as f:
    f.write(f"{{w2}} {{h2}} {{bpr}}\\n".encode())
    f.write(bytes(data))
"""
    try:
        r = subprocess.run(
            ["uv", "run", "--no-project", "--python", str(GRANTED_PY),
             "--with", "pyobjc-framework-Quartz", "python", "-c", code],
            capture_output=True, timeout=90)
        if r.returncode != 0:
            return None
        header = out_path.open("rb").readline().split()
        return int(header[0]), int(header[1])
    except Exception:
        return None


def _load_raw(path: Path):
    import numpy as np
    with path.open("rb") as f:
        w, h, bpr = (int(v) for v in f.readline().split())
        buf = f.read()
    arr = np.frombuffer(buf, dtype=np.uint8)
    arr = arr[: h * bpr].reshape(h, bpr)[:, : w * 4].reshape(h, w, 4)
    return arr[:, :, :3].astype("int16")


def click_call_popup(before: Path, timeout_s: float = 12) -> bool:
    """macOS shows call confirmations as a notification banner (top-right).
    Diff the region against the pre-open capture, click the changed area."""
    import numpy as np
    x0, y0, _, _ = POPUP_REGION
    ref = _load_raw(before)
    scale_x = ref.shape[1] / POPUP_REGION[2]  # retina pixel -> point scale
    scale_y = ref.shape[0] / POPUP_REGION[3]
    deadline = time.time() + timeout_s
    after = STATE_DIR / "popup-after.raw"
    while time.time() < deadline:
        time.sleep(1.5)
        if capture_region_raw(after) is None:
            return False
        cur = _load_raw(after)
        if cur.shape != ref.shape:
            return False
        diff = (np.abs(cur - ref).sum(axis=2) > 40)
        if diff.sum() < 4000:  # banner is ~350x80pt -> way more pixels
            continue
        ys, xs = np.nonzero(diff)
        cx = x0 + int(xs.mean() / scale_x)
        cy = y0 + int(ys.mean() / scale_y)
        r = run([CLICLICK, f"c:{cx},{cy}"])
        if r.returncode == 0:
            log(f"clicked call popup at ({cx},{cy})")
            return True
        return False
    return False

def axctl_available() -> bool:
    """True if this process can use the Accessibility API (daemon sessions: yes;
    plain Terminal: usually no)."""
    try:
        r = run(
            ["uv", "run", "--no-project", "--with",
             "pyobjc-framework-ApplicationServices", "python", "-c",
             "from ApplicationServices import AXIsProcessTrusted; print(AXIsProcessTrusted())"],
            timeout=60,
        )
        return "True" in r.stdout
    except Exception:
        return False


def ax_click_button(app: str, titles: list[str]) -> bool:
    """Try to click the first button matching any of the given titles."""
    for title in titles:
        r = run([str(AXCTL), "click", app, "--title", title], timeout=30)
        if r.returncode == 0 and "Error" not in r.stderr:
            log(f"clicked '{title}' in {app} via axctl")
            return True
    return False


def ax_click_desc(app: str, desc: str, retries: int = 2) -> bool:
    """Click an element by AXDescription (SwiftUI apps label buttons this way)."""
    for _ in range(retries):
        r = run([str(AXCTL), "click", app, "--desc", desc], timeout=30)
        if r.returncode == 0 and "Error" not in r.stderr and "Error" not in r.stdout:
            return True
        time.sleep(0.7)
    return False


def dial_via_phone_app(number: str) -> bool:
    """Dial a number with the macOS Phone app keypad via Accessibility.

    Deterministic: open Phone -> Keypad view -> click digit buttons -> Call.
    Requires AX (daemon-spawned sessions have it; plain Terminal does not).
    Keypad has no '+' — leading + is dropped (US: 1 + 10 digits works).
    """
    digits = [c for c in number.lstrip("+") if c.isdigit() or c in "*#"]
    if not digits:
        return False
    # Relaunch Phone AFTER audio routing: it binds its audio devices at launch,
    # so a stale Phone.app pipes far-end audio to the old output. (We do NOT
    # kill avconferenced — that destabilizes Phone's UI so the Keypad view
    # never renders; the volume/output-device fix is what actually restores
    # capture, not restarting the AV daemon.)
    run(["osascript", "-e", 'tell application "Phone" to quit'])
    time.sleep(1.5)
    names = {"*": "Star", "#": "Pound"}
    seq = ",".join(["Keypad"] + [names.get(d, d) for d in digits] + ["Call"])
    # Relaunch + dial, with one retry: a cold Phone.app can take >6s to render
    # the keypad, and clickseq gives up after ~3s per element.
    for attempt in (1, 2):
        run(["open", "-a", "Phone"])
        time.sleep(4.5 if attempt == 1 else 8)
        r = run([str(AXCTL), "clickseq", "Phone", seq], timeout=120)
        if r.returncode == 0:
            log(f"dialed {''.join(digits)} via Phone app keypad")
            return True
        log(f"clickseq dial attempt {attempt} failed: "
            f"{(r.stderr or r.stdout).strip()[-200:]}")
    return False


def press_return_fallback() -> bool:
    """Confirm a default-button dialog by pressing Return via cliclick
    (the cliclick binary carries its own Accessibility grant)."""
    if not Path(CLICLICK).exists():
        return False
    run(["open", "-a", "FaceTime"])  # make sure the dialog is frontmost
    time.sleep(1.0)
    r = run([CLICLICK, "kp:return"])
    if r.returncode == 0:
        log("pressed Return via cliclick (default-button confirm)")
        return True
    return False


# ---------------------------------------------------------------- call control

def normalize_target(target: str) -> str:
    t = target.strip()
    if "@" in t:
        return t
    digits = "".join(c for c in t if c.isdigit() or c == "+")
    return digits


def cmd_start(args) -> None:
    target = normalize_target(args.target)
    devices_setup()
    # Apple IDs (emails) can only go over FaceTime. Phone numbers default to
    # tel:// which FaceTime relays over the tethered iPhone's cellular line
    # (Continuity "Calls from iPhone") — reaches restaurants, landlines, any
    # number. --facetime forces FaceTime Audio (Apple devices only, no iPhone
    # needed).
    if args.video:
        scheme = "facetime"
    elif "@" in target or args.facetime:
        scheme = "facetime-audio"
    else:
        scheme = "tel"

    # Preferred dialer for plain numbers: drive the Phone app keypad via AX —
    # deterministic, no notification banner. Works from daemon sessions.
    if scheme == "tel" and args.dialer in ("auto", "phone-app"):
        if dial_via_phone_app(target):
            state = load_state()
            state.update({"in_call": True, "target": target,
                          "started_at": time.time(), "dialer": "phone-app"})
            save_state(state)
            print(f"call dialed to {target} via Phone app. Next: "
                  "`call listen --wait-for-speech --max 45`.")
            return
        if args.dialer == "phone-app":
            devices_restore()
            die("Phone-app dial failed (no Accessibility in this context?). "
                "Run from a daemon session, or use --dialer url.")
        log("Phone-app dial unavailable; falling back to tel:// + banner click")

    url = f"{scheme}://{target}"
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    before = STATE_DIR / "popup-before.raw"
    have_ref = capture_region_raw(before) is not None
    log(f"placing call: {url}")
    r = run(["open", url])
    if r.returncode != 0:
        devices_restore()
        die(f"failed to open {url}: {r.stderr.strip()}")

    # macOS confirms URL-initiated calls with a "click to call" notification
    # banner in the top-right — click it via screen-diff + cliclick.
    confirmed = click_call_popup(before) if have_ref else False
    if not confirmed:
        # older flow: an in-app FaceTime dialog with a default Call button
        time.sleep(1.5)
        run(["open", "-a", "FaceTime"])
        confirmed = ax_click_button("FaceTime", ["Call", "Call Using iPhone", target])
    if not confirmed:
        confirmed = press_return_fallback()
    if not confirmed:
        log("WARNING: could not confirm the call dialog automatically. "
            "Check FaceTime UI (axctl tree FaceTime) — the call may not have started.")

    state = load_state()
    state.update({"in_call": True, "target": target, "started_at": time.time()})
    save_state(state)
    print(f"call initiated to {target}. Next: `call listen --wait-for-speech --max 45` "
          "to wait for them to answer and speak.")


def cmd_end(args) -> None:
    # Best effort: click the end button, then quit the calling apps (reliably ends)
    ax_click_desc("Phone", "End")
    ax_click_button("FaceTime", ["Leave", "End", "End Call"])
    run(["osascript", "-e", 'tell application "Phone" to quit'])
    run(["osascript", "-e", 'tell application "FaceTime" to quit'])
    devices_restore()
    state = load_state()
    dur = ""
    if state.get("started_at"):
        dur = f" ({int(time.time() - state['started_at'])}s)"
    state.update({"in_call": False, "target": None, "started_at": None})
    save_state(state)
    print(f"call ended{dur}. Audio devices restored.")


def cmd_status(args) -> None:
    state = load_state()
    mic_ok, spk_ok = blackhole_installed()
    ft_running = run(["pgrep", "-x", "FaceTime"]).returncode == 0
    print(f"blackhole 2ch (virtual mic):     {'OK' if mic_ok else 'MISSING'}")
    print(f"blackhole 16ch (virtual spkr):   {'OK' if spk_ok else 'MISSING'}")
    print(f"default input:                   {current_device('input')}")
    print(f"default output:                  {current_device('output')}")
    print(f"facetime running:                {ft_running}")
    print(f"state: in_call={state.get('in_call', False)} target={state.get('target')}")
    if state.get("started_at"):
        print(f"call duration: {int(time.time() - state['started_at'])}s")


# ---------------------------------------------------------------- speaking

def tts_generate(text: str, engine: str, voice: str, style: str | None,
                 speed: float) -> Path:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    key = hashlib.sha256(f"{engine}|{voice}|{style}|{speed}|{text}".encode()).hexdigest()[:16]
    wav = STATE_DIR / f"tts-{key}.wav"
    if wav.exists():
        return wav
    if engine == "qwen":
        cmd = [str(SPEAK_QWEN), text, "-o", str(wav)]
        if style:
            cmd += ["--style", style]
    else:
        cmd = [str(SPEAK_KOKORO), text, "-o", str(wav), "-v", voice, "-s", str(speed)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    if r.returncode != 0 or not wav.exists():
        die(f"TTS failed: {r.stderr.strip()[-500:]}")
    return wav


def play_wav_to_device(wav: Path, device: str) -> float:
    """Play a wav file into a specific output device. Returns duration seconds."""
    import numpy as np  # noqa: F401
    import sounddevice as sd
    import soundfile as sf

    # Normalize to 48k stereo first — BlackHole's nominal rate — via ffmpeg
    norm = wav.with_suffix(".48k.wav")
    if not norm.exists() or norm.stat().st_mtime < wav.stat().st_mtime:
        r = run([FFMPEG, "-y", "-i", str(wav), "-ar", "48000", "-ac", "2",
                 str(norm)], timeout=120)
        if r.returncode != 0:
            die(f"ffmpeg resample failed: {r.stderr[-300:]}")
    data, rate = sf.read(str(norm), dtype="float32")
    sd.play(data, samplerate=rate, device=device)
    sd.wait()
    return len(data) / rate


def cmd_say(args) -> None:
    if args.wav:
        wav = Path(args.wav).expanduser()
        if not wav.exists():
            die(f"wav not found: {wav}")
    elif not args.text.strip():
        die("nothing to say: pass text or --wav")
    else:
        wav = tts_generate(args.text, args.engine, args.voice, args.style, args.speed)
    mic_ok, _ = blackhole_installed()
    if not mic_ok:
        die(f"'{MIC_DEVICE}' not installed — brew install blackhole-2ch blackhole-16ch")
    dur = play_wav_to_device(wav, args.device or MIC_DEVICE)
    print(f"spoke {dur:.1f}s of audio into the call")


# ---------------------------------------------------------------- listening

def record_vad(device: str, max_seconds: float, wait_for_speech: bool,
               silence_s: float, min_speech_s: float, thresh_db: float):
    """Record from `device` with a simple energy VAD.

    Returns (float32 mono 16k numpy array or None, speech_detected: bool).
    In wait_for_speech mode: waits (up to max_seconds) for speech to start,
    then records until `silence_s` of trailing silence.
    Otherwise: records max_seconds flat.
    """
    import numpy as np
    import sounddevice as sd

    block_s = 0.03
    blocksize = int(RECORD_RATE * block_s)
    thresh = 10 ** (thresh_db / 20)

    chunks: list = []
    speech_started = not wait_for_speech
    speech_detected = False
    speech_run = 0.0
    silence_run = 0.0
    t0 = time.time()
    recorded = 0.0

    with sd.InputStream(device=device, channels=1, samplerate=RECORD_RATE,
                        blocksize=blocksize, dtype="float32") as stream:
        while True:
            block, _ = stream.read(blocksize)
            mono = block[:, 0]
            rms = float(np.sqrt(np.mean(mono ** 2))) if len(mono) else 0.0
            loud = rms > thresh

            if not speech_started:
                if loud:
                    speech_run += block_s
                    chunks.append(mono.copy())  # keep onset audio
                    if speech_run >= min_speech_s:
                        speech_started = True
                        speech_detected = True
                        log("speech detected, recording...")
                else:
                    speech_run = 0.0
                    chunks = chunks[-10:]  # keep a little pre-roll
                if time.time() - t0 > max_seconds:
                    return None, False
                continue

            chunks.append(mono.copy())
            recorded += block_s
            if loud:
                speech_detected = True
                silence_run = 0.0
            else:
                silence_run += block_s

            if wait_for_speech and silence_run >= silence_s:
                break
            if recorded >= max_seconds:
                break

    if not chunks:
        return None, speech_detected
    return np.concatenate(chunks), speech_detected


def transcribe(audio, rate: int) -> str:
    import numpy as np
    import soundfile as sf
    peak = float(np.max(np.abs(audio))) if len(audio) else 0.0
    if peak < 0.001:  # < -60dBFS: genuine silence — boosting it just makes
        return ""     # whisper hallucinate words from noise
    if peak < 0.5:    # normalize quiet captures to -3dBFS before whisper
        audio = audio * (0.7 / peak)
    wav = STATE_DIR / "listen-last.wav"
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    sf.write(str(wav), audio, rate, subtype="PCM_16")
    r = run([WHISPER_CLI, "-m", str(WHISPER_MODEL), "-f", str(wav),
             "-nt", "--no-prints"], timeout=300)
    if r.returncode != 0:
        die(f"whisper failed: {r.stderr[-300:]}")
    return r.stdout.strip()


def cmd_listen(args) -> None:
    _, spk_ok = blackhole_installed()
    if not spk_ok:
        die(f"'{SPK_DEVICE}' not installed — brew install blackhole-2ch blackhole-16ch")
    audio, speech = record_vad(
        device=args.device or SPK_DEVICE,
        max_seconds=args.max,
        wait_for_speech=args.wait_for_speech,
        silence_s=args.silence,
        min_speech_s=args.min_speech,
        thresh_db=args.threshold_db,
    )
    if audio is None:
        result = {"transcript": "", "speech_detected": False, "seconds": 0.0}
        print(json.dumps(result) if args.json else
              "(no speech detected within timeout)")
        return
    if args.raw:
        import soundfile as sf
        sf.write(args.raw, audio, RECORD_RATE, subtype="PCM_16")
        log(f"raw audio saved to {args.raw}")
    text = "" if args.no_transcribe else transcribe(audio, RECORD_RATE)
    seconds = round(len(audio) / RECORD_RATE, 1)
    if args.json:
        import numpy as np
        peak = float(np.max(np.abs(audio))) if len(audio) else 0.0
        peak_db = round(20 * math.log10(peak), 1) if peak > 0 else -120.0
        print(json.dumps({"transcript": text, "speech_detected": speech,
                          "seconds": seconds, "peak_db": peak_db}))
    else:
        print(text if text else "(unintelligible / no transcript)")


# ---------------------------------------------------------------- converse

CONVERSE_SYSTEM = """You are {assistant_name}, {owner_name}'s assistant, speaking on a LIVE PHONE CALL on their behalf.

GOAL OF THIS CALL: {goal}

Sound like a person, not a bot:
- Natural, warm, casual-professional. Use contractions. Brief acknowledgments ("Sure", "Perfect", "Got it") are good.
- Introduce yourself simply as "{assistant_name}, {owner_name}'s assistant" when a greeting is called for. Do NOT volunteer that you're an AI on routine errands — but if anyone asks whether you're an AI, a robot, or a recording, answer honestly and briefly, then get back to the task. Never deny being an AI.
- Reply with ONLY the words to speak aloud. 1-2 short conversational sentences. No markdown, no stage directions, no emoji.
- Open with a short first sentence (a few words), then continue if needed.
- Numbers/times: speak them naturally ("seven thirty" not "7:30").

Mechanics:
- You receive the other person's words via speech-to-text — it may contain errors; infer intent.
- If the goal is achieved or the conversation is clearly over, end your reply with the exact token [HANGUP].
- If you hear hold music, an automated menu, or ringing sounds (e.g. "(phone rings)"), output [WAIT] alone to keep listening.
- Stay on-goal and brief. Phone people hate monologues."""


_SENT_BOUNDARY = None  # compiled lazily in cmd_converse


def _find_sentence_cut(buf: str, min_len: int = 20) -> int | None:
    """Index just past the earliest sentence boundary usable for TTS chunking,
    or None. Guards common abbreviations."""
    import re
    for m in re.finditer(r"[.!?…](?=\s|$)", buf):
        cand = buf[: m.end()]
        if len(cand.strip()) < min_len:
            continue
        if re.search(r"\b(?:Mr|Mrs|Ms|Dr|St|vs|etc)\.$", cand):
            continue
        return m.end()
    return None


def cmd_converse(args) -> None:
    """Real-time conversation loop, pipelined for latency:
    thinking-off Haiku streams tokens -> first sentence goes to TTS while the
    rest streams -> persistent output stream plays chunks gaplessly.
    ~1.5-2.5s from the caller's last word to first audio."""
    import asyncio
    import queue as queue_mod
    import threading

    import sounddevice as sd

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    transcript_path = Path(args.transcript or (STATE_DIR / "converse-transcript.txt"))

    def tlog(who: str, text: str) -> None:
        line = f"[{time.strftime('%H:%M:%S')}] {who}: {text}"
        log(line)
        with transcript_path.open("a") as f:
            f.write(line + "\n")

    # --- preload the TTS engine once (in-process, no subprocess per phrase).
    # Both engines emit 24kHz mono float32 -> unified synth(text) -> np.ndarray.
    import numpy as np
    TTS_RATE = 24000
    engine = args.tts_engine
    if engine == "pocket":
        # Kyutai Pocket TTS — more natural conversational prosody, RTF ~0.11,
        # ~30ms first chunk. Falls back to kokoro if it can't load.
        try:
            log("loading Pocket TTS...")
            from pocket_tts import TTSModel
            _pt = TTSModel.load_model()
            _voice_state = _pt.get_state_for_audio_prompt(args.voice)

            def synth(text: str) -> "np.ndarray":
                return np.asarray(_pt.generate_audio(_voice_state, text)).ravel().astype("float32")
        except Exception as e:
            log(f"Pocket TTS unavailable ({e}); falling back to kokoro")
            engine = "kokoro"
    if engine == "kokoro":
        log("loading kokoro TTS...")
        from kokoro_onnx import Kokoro
        models = HOME / ".claude/skills/tts/models"
        _kokoro = Kokoro(str(models / "kokoro-v1.0.onnx"), str(models / "voices-v1.0.bin"))
        kvoice = args.voice if args.voice in _kokoro.get_voices() else "af_heart"

        def synth(text: str) -> "np.ndarray":
            samples, _ = _kokoro.create(text, voice=kvoice, speed=1.0)
            return np.asarray(samples).ravel().astype("float32")
    log(f"TTS engine: {engine}, voice: {args.voice}")
    KOKORO_RATE = TTS_RATE  # (name kept for the OutputStream below)

    # --- persistent output stream + player thread (P3): sd.play() costs
    # ~250ms per call; OutputStream.write() is instant and gapless.
    playq: "queue_mod.Queue" = queue_mod.Queue()
    out_stream = sd.OutputStream(device=MIC_DEVICE, samplerate=KOKORO_RATE,
                                 channels=1, dtype="float32")
    out_stream.start()

    def _player():
        while True:
            arr = playq.get()
            if arr is None:
                playq.task_done()
                break
            out_stream.write(arr.reshape(-1, 1).astype("float32"))
            playq.task_done()

    player_thread = threading.Thread(target=_player, daemon=True)
    player_thread.start()

    def say_now(text: str) -> None:
        """Synchronous speak (greeting / fallback): synth + enqueue + drain."""
        playq.put(synth(text))
        playq.join()
        tlog("ME", text)

    def hear(max_s: float, silence_s: float = 0.6) -> str:
        # 0.6s trailing-silence endpoint (was 1.0) — P4; LiveKit ships 0.5.
        audio, _ = record_vad(device=SPK_DEVICE, max_seconds=max_s,
                              wait_for_speech=True, silence_s=silence_s,
                              min_speech_s=0.25, thresh_db=args.threshold_db)
        if audio is None:
            return ""
        return transcribe(audio, RECORD_RATE)

    from claude_agent_sdk import ClaudeSDKClient, ClaudeAgentOptions

    owner = run([str(HOME / "dispatch/bin/identity"), "owner.name"]).stdout.strip() or "the owner"
    assistant = run([str(HOME / "dispatch/bin/identity"), "self"]).stdout.strip() or "an assistant"
    system = CONVERSE_SYSTEM.format(goal=args.goal, owner_name=owner,
                                    assistant_name=assistant)

    async def _loop():
        options = ClaudeAgentOptions(
            cli_path=HOME / ".local" / "bin" / "claude",  # system CLI for OAuth
            model="claude-haiku-4-5-20251001",
            system_prompt=system,
            allowed_tools=[],
            max_turns=1,
            max_thinking_tokens=0,          # P1: thinking-on TTFT is 2.7-6.5s
            include_partial_messages=True,  # P2: stream token deltas
            setting_sources=[],
        )
        async with ClaudeSDKClient(options=options) as client:

            async def brain_sentences(user_text: str):
                """Yield complete sentences as Haiku streams them (P2)."""
                await client.query(user_text)
                buf = ""
                async for msg in client.receive_response():
                    if type(msg).__name__ != "StreamEvent":
                        continue
                    ev = msg.event
                    if (ev.get("type") == "content_block_delta"
                            and ev.get("delta", {}).get("type") == "text_delta"):
                        buf += ev["delta"]["text"]
                        while True:
                            cut = _find_sentence_cut(buf)
                            if cut is None:
                                break
                            yield buf[:cut].strip()
                            buf = buf[cut:]
                if buf.strip():
                    yield buf.strip()

            async def respond(user_text: str, t0: float) -> tuple[str, bool, bool, float, float]:
                """Stream a reply: synth+enqueue sentence 1 while the rest
                streams. Returns as soon as everything is ENQUEUED (NOT after
                playback) so the brain-timeout never waits on the audio device.
                Returns (text, hangup, wait, first_audio_s, audio_dur_s)."""
                spoken: list[str] = []
                hangup = False
                first_audio = None
                audio_dur = 0.0
                async for sent in brain_sentences(user_text):
                    if sent.startswith("[WAIT]"):
                        return "", False, True, 0.0, 0.0
                    if "[HANGUP]" in sent:
                        hangup = True
                        sent = sent.replace("[HANGUP]", "").strip()
                    # Hard guard: never read a document down the phone.
                    if len(sent) > 300:
                        sent = sent[:300]
                        hangup = True
                    if sent:
                        samples = await asyncio.to_thread(synth, sent)
                        playq.put(samples)
                        if first_audio is None:
                            first_audio = time.time() - t0
                        audio_dur += len(samples) / KOKORO_RATE
                        spoken.append(sent)
                    if sum(len(s) for s in spoken) > 600:
                        log("reply length cap hit — truncating turn")
                        break
                return (" ".join(spoken), hangup, False,
                        first_audio or 0.0, audio_dur)

            # Warm the pipelines while the phone is still ringing so turn 1
            # doesn't pay cold-start (~1.5s saved on the first real reply):
            # kokoro's first synth, whisper's first decode, and the SDK's
            # first token all have startup cost.
            try:
                await asyncio.to_thread(synth, "Hello.")
                await asyncio.to_thread(
                    transcribe, np.zeros(RECORD_RATE // 2, dtype="float32"),
                    RECORD_RATE)
                await client.query("Reply with exactly the word: ready")
                async for _m in client.receive_response():
                    pass
                log("pipelines warmed")
            except Exception as e:
                log(f"warmup skipped: {e}")

            deadline = time.time() + args.answer_timeout
            heard = ""
            while time.time() < deadline and not heard:
                heard = hear(max_s=min(15, deadline - time.time()))
            if not heard:
                tlog("SYS", "no answer detected; leaving message then hanging up")
                if args.greeting:
                    say_now(args.greeting)
                return
            tlog("THEM", heard)
            if args.greeting:
                say_now(args.greeting)

            silent_rounds = 0
            end_at = time.time() + args.max_minutes * 60
            while time.time() < end_at:
                heard = hear(max_s=args.turn_timeout)
                if not heard:
                    silent_rounds += 1
                    if silent_rounds >= 2:
                        tlog("SYS", "two silent rounds — assuming hangup")
                        break
                    continue
                silent_rounds = 0
                tlog("THEM", heard)
                t0 = time.time()
                # Timeout wraps ONLY brain+synth+enqueue (target ~1-2s, cap
                # 30s) — never the audio device, so a stalled speaker can't
                # hang the turn.
                try:
                    text, hangup, wait, first_audio, audio_dur = \
                        await asyncio.wait_for(respond(heard, t0), timeout=30)
                except asyncio.TimeoutError:
                    tlog("SYS", "brain turn timed out (30s) — apologizing, hanging up")
                    say_now("I'm so sorry, I'm having some technical trouble. I'll try again later. Goodbye!")
                    break
                if wait:
                    tlog("SYS", "waiting (hold/menu)")
                    continue
                if text:
                    tlog("ME", f"{text}  (reply started {first_audio:.1f}s after they finished)")
                # Wait for playback to drain before listening again (avoid
                # talking over ourselves), but BOUND it — a wedged device
                # can't freeze the call. Slack = audio duration + 4s.
                try:
                    await asyncio.wait_for(asyncio.to_thread(playq.join),
                                           timeout=audio_dur + 4)
                except asyncio.TimeoutError:
                    log("playback drain timed out — continuing")
                if hangup:
                    tlog("SYS", "goal met — hanging up")
                    break

    try:
        asyncio.run(_loop())
    finally:
        playq.put(None)
        player_thread.join(timeout=5)
        out_stream.stop()
        out_stream.close()
    print(f"conversation finished. Transcript: {transcript_path}")


# ---------------------------------------------------------------- self test

def cmd_test_audio(args) -> None:
    """Loopback test: play TTS into BlackHole 2ch while recording BlackHole 2ch.
    Anything written to a BlackHole device's output is mirrored to its input,
    so this exercises TTS -> playback -> capture -> whisper without a call."""
    mic_ok, _ = blackhole_installed()
    if not mic_ok:
        die(f"'{MIC_DEVICE}' not installed — brew install blackhole-2ch blackhole-16ch")
    phrase = "This is a loopback test of the phone call audio pipeline."
    log("generating TTS...")
    wav = tts_generate(phrase, "kokoro", "af_nova", None, 1.0)

    import threading
    result: dict = {}

    def _record():
        result["audio"], result["speech"] = record_vad(
            device=MIC_DEVICE, max_seconds=12, wait_for_speech=True,
            silence_s=1.0, min_speech_s=0.2, thresh_db=-45)

    t = threading.Thread(target=_record)
    t.start()
    time.sleep(0.8)
    log("playing into virtual mic...")
    play_wav_to_device(wav, MIC_DEVICE)
    t.join(timeout=20)

    audio = result.get("audio")
    if audio is None:
        die("FAIL: no audio captured from loopback")
    text = transcribe(audio, RECORD_RATE).lower()
    log(f"transcript: {text!r}")
    hits = sum(w in text for w in ("loopback", "test", "audio", "pipeline"))
    if hits >= 2:
        print("PASS: full audio pipeline works (TTS -> virtual device -> capture -> whisper)")
    else:
        die(f"FAIL: transcript didn't match expected phrase: {text!r}")


# ---------------------------------------------------------------- doctor

def cmd_doctor(args) -> None:
    checks: list[tuple[str, bool, str]] = []
    mic_ok, spk_ok = blackhole_installed()
    checks.append(("BlackHole 2ch (virtual mic)", mic_ok,
                   "brew install blackhole-2ch  (needs admin password)"))
    checks.append(("BlackHole 16ch (virtual speaker)", spk_ok,
                   "brew install blackhole-16ch (needs admin password)"))
    checks.append(("SwitchAudioSource", Path(SWITCH).exists(),
                   "brew install switchaudio-osx"))
    checks.append(("ffmpeg", Path(FFMPEG).exists(), "brew install ffmpeg"))
    checks.append(("whisper-cli", Path(WHISPER_CLI).exists(),
                   "brew install whisper-cpp"))
    checks.append(("whisper model (base.en)", WHISPER_MODEL.exists(),
                   "curl -L -o ~/.local/share/whisper/ggml-base.en.bin "
                   "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin"))
    checks.append(("kokoro TTS", SPEAK_KOKORO.exists(), "see /tts skill"))
    checks.append(("cliclick (dialog fallback)", Path(CLICLICK).exists(),
                   "brew install cliclick"))
    ax = axctl_available()
    checks.append(("Accessibility (axctl)", ax,
                   "works from daemon sessions; from Terminal grant Accessibility "
                   "to Terminal in System Settings > Privacy & Security"))
    all_ok = True
    for name, ok, fix in checks:
        mark = "✓" if ok else "✗"
        print(f"  {mark} {name}" + ("" if ok else f"  → {fix}"))
        if not ok and "Accessibility" not in name:
            all_ok = False
    print()
    if all_ok:
        print("ready to make calls" + ("" if ax else
              " (UI confirm will use cliclick Return-key fallback)"))
    else:
        print("NOT ready — fix the ✗ items above")
        sys.exit(2)


def cmd_devices(args) -> None:
    if args.setup:
        devices_setup()
    elif args.restore:
        devices_restore()
    else:
        mic_ok, spk_ok = blackhole_installed()
        print(f"devices: {', '.join(list_audio_devices())}")
        print(f"blackhole installed: mic(2ch)={mic_ok} spkr(16ch)={spk_ok}")
        print(f"default input:  {current_device('input')}")
        print(f"default output: {current_device('output')}")


# ---------------------------------------------------------------- main

def main() -> None:
    p = argparse.ArgumentParser(prog="call", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("start", help="place a FaceTime Audio call")
    sp.add_argument("target", help="phone number (+1...) or Apple ID email")
    sp.add_argument("--video", action="store_true", help="FaceTime video instead of audio")
    sp.add_argument("--facetime", action="store_true",
                    help="force FaceTime Audio for a phone number "
                         "(default for numbers is cellular via tethered iPhone)")
    sp.add_argument("--dialer", choices=["auto", "phone-app", "url"],
                    default="auto",
                    help="phone-app: AX-drive the Phone app keypad (needs "
                         "daemon context); url: tel:// + banner click; "
                         "auto: try phone-app, fall back to url")
    sp.set_defaults(func=cmd_start)

    sp = sub.add_parser("say", help="speak text into the active call")
    sp.add_argument("text", nargs="?", default="")
    sp.add_argument("--voice", default="af_heart", help="kokoro voice (default af_nova)")
    sp.add_argument("--engine", choices=["kokoro", "qwen"], default="kokoro")
    sp.add_argument("--style", help="qwen voice style prompt")
    sp.add_argument("--speed", type=float, default=1.0)
    sp.add_argument("--wav", help="play an existing wav instead of TTS")
    sp.add_argument("--device", help=f"override output device (default {MIC_DEVICE})")
    sp.set_defaults(func=cmd_say)

    sp = sub.add_parser("listen", help="record + transcribe the far end")
    sp.add_argument("--max", type=float, default=30, help="max seconds (default 30)")
    sp.add_argument("--wait-for-speech", action="store_true",
                    help="wait for speech to start, stop after trailing silence")
    sp.add_argument("--silence", type=float, default=1.2,
                    help="trailing silence seconds to stop (default 1.2)")
    sp.add_argument("--min-speech", type=float, default=0.3,
                    help="min speech seconds to trigger (default 0.3)")
    sp.add_argument("--threshold-db", type=float, default=-55,
                    help="speech energy threshold dBFS (default -55)")
    sp.add_argument("--raw", help="also save raw wav to this path")
    sp.add_argument("--no-transcribe", action="store_true")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--device", help=f"override input device (default {SPK_DEVICE})")
    sp.set_defaults(func=cmd_listen)

    sp = sub.add_parser("converse", help="real-time conversation loop (run right after start)")
    sp.add_argument("--goal", required=True, help="what this call is trying to accomplish")
    sp.add_argument("--greeting", help="opening line, spoken when they answer")
    sp.add_argument("--tts-engine", choices=["pocket", "kokoro"], default="pocket",
                    help="pocket=Kyutai Pocket TTS (natural, default); kokoro=fallback")
    sp.add_argument("--voice", default="alba",
                    help="voice: pocket (alba/marius/jean/eve/...) or kokoro (af_heart/...)")
    sp.add_argument("--answer-timeout", type=float, default=35,
                    help="seconds to wait for first speech (default 35)")
    sp.add_argument("--turn-timeout", type=float, default=20,
                    help="max seconds to wait for them to speak each turn")
    sp.add_argument("--max-minutes", type=float, default=8)
    sp.add_argument("--threshold-db", type=float, default=-55)
    sp.add_argument("--transcript", help="transcript file path")
    sp.set_defaults(func=cmd_converse)

    sp = sub.add_parser("end", help="hang up and restore audio devices")
    sp.set_defaults(func=cmd_end)

    sp = sub.add_parser("status", help="show call/audio state")
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("devices", help="show or change audio routing")
    sp.add_argument("--setup", action="store_true", help="route to BlackHole devices")
    sp.add_argument("--restore", action="store_true", help="restore saved defaults")
    sp.set_defaults(func=cmd_devices)

    sp = sub.add_parser("doctor", help="check prerequisites")
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("test-audio", help="loopback self-test (no call placed)")
    sp.set_defaults(func=cmd_test_audio)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
