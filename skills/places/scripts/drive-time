#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["requests"]
# ///
"""
drive-time - driving distance + time between two places, no API key needed.

Usage:
    drive-time FROM TO [--depart HH:MM] [--json]

Examples:
    drive-time "123 Main St, Pacifica, CA" "340 Walnut St, Redwood City, CA"
    drive-time "San Francisco, CA" "Redwood City, CA" --depart 08:15
    drive-time "SFO" "Palo Alto, CA" --json

How it works:
  1. Geocodes both ends with OpenStreetMap Nominatim (1 req/s, results cached
     in ~/.cache/drive-time/geocode.json). If OSM can't match a house number,
     falls back to the free US Census geocoder; else uses the street and says so.
  2. Routes with the public OSRM demo server -> distance + FREE-FLOW time
     (no live traffic).
  3. Prints a traffic range from fixed multipliers:
       - --depart in 07:00-10:00 or 16:00-19:00 local -> rush hour, x1.3-1.6
       - no --depart                                  -> typical traffic, x1.3-1.6
       - --depart outside rush hours                  -> off-peak, x1.05-1.2
     These ranges are ESTIMATES, not live traffic.
  4. If a Google key exists (env GOOGLE_MAPS_API_KEY or Keychain service
     'google-maps-api-key'), also queries the Google Routes API for a
     traffic-aware time. With no key this step is skipped silently.

Exit codes: 0 ok, 1 geocode/route failure, 2 bad arguments.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

import requests

USER_AGENT = "dispatch-places-drive-time/1.0 (+https://github.com/svenflow/dispatch)"
NOMINATIM_URL = "https://nominatim.openstreetmap.org/search"
OSRM_URL = "https://router.project-osrm.org/route/v1/driving/{lon1},{lat1};{lon2},{lat2}"
CENSUS_URL = "https://geocoding.geo.census.gov/geocoder/locations/onelineaddress"
GOOGLE_ROUTES_URL = "https://routes.googleapis.com/directions/v2:computeRoutes"
CACHE_PATH = Path.home() / ".cache" / "drive-time" / "geocode.json"
METERS_PER_MILE = 1609.344

RUSH_MULT = (1.3, 1.6)
OFFPEAK_MULT = (1.05, 1.2)
RUSH_WINDOWS = ((7 * 60, 10 * 60), (16 * 60, 19 * 60))  # minutes since midnight, [start, end)

_last_nominatim_call = 0.0


class DriveTimeError(Exception):
    pass


def _ua_headers() -> dict:
    ua = USER_AGENT
    contact = os.environ.get("NOMINATIM_CONTACT")
    if contact:
        ua = f"{ua} contact: {contact}"
    return {"User-Agent": ua, "Accept-Language": "en"}


# ---------------------------------------------------------------- geocoding

def _load_cache() -> dict:
    try:
        return json.loads(CACHE_PATH.read_text())
    except Exception:
        return {}


def _save_cache(cache: dict) -> None:
    try:
        CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
        CACHE_PATH.write_text(json.dumps(cache, indent=1))
    except Exception:
        pass  # cache is best-effort


def _nominatim(query: str) -> dict | None:
    global _last_nominatim_call
    wait = 1.1 - (time.monotonic() - _last_nominatim_call)
    if wait > 0:
        time.sleep(wait)
    try:
        r = requests.get(
            NOMINATIM_URL,
            params={"q": query, "format": "jsonv2", "limit": 1,
                    "addressdetails": 1},
            headers=_ua_headers(),
            timeout=20,
        )
    except requests.RequestException as e:
        raise DriveTimeError(f"Nominatim request failed: {e}") from e
    finally:
        _last_nominatim_call = time.monotonic()
    if r.status_code == 429 or r.status_code == 403:
        raise DriveTimeError(f"Nominatim refused the request (HTTP {r.status_code}); slow down and retry later")
    if r.status_code != 200:
        raise DriveTimeError(f"Nominatim HTTP {r.status_code}: {r.text}")
    data = r.json()
    return data[0] if data else None


def _census(query: str) -> dict | None:
    """US Census geocoder (free, no key): interpolates US house numbers that OSM lacks."""
    try:
        r = requests.get(
            CENSUS_URL,
            params={"address": query, "benchmark": "Public_AR_Current", "format": "json"},
            headers=_ua_headers(),
            timeout=20,
        )
        matches = r.json()["result"]["addressMatches"] if r.status_code == 200 else []
    except Exception:
        return None
    if not matches:
        return None
    m = matches[0]
    return {"lat": m["coordinates"]["y"], "lon": m["coordinates"]["x"],
            "display_name": m["matchedAddress"] + " (US Census)"}


def geocode(query: str, cache: dict) -> dict:
    """Return {query, lat, lon, display_name, precision}."""
    key = query.strip().lower()
    if key in cache:
        return cache[key]

    has_number = re.match(r"^\s*\d+[A-Za-z]?\s+\S", query) is not None
    precision = "exact"
    hit = _nominatim(query)
    if has_number and (hit is None or not (hit.get("address") or {}).get("house_number")):
        # OSM often lacks house numbers; try the US Census interpolating geocoder.
        census = _census(query)
        if census:
            hit = census
        elif hit is not None:
            precision = "street only (house number not matched)"
    if hit is None and has_number:
        hit = _nominatim(re.sub(r"^\s*\d+[A-Za-z]?\s+", "", query))
        precision = "street only (house number not matched)"
    if hit is None:
        raise DriveTimeError(f"Could not geocode: {query!r}")

    result = {
        "query": query,
        "lat": float(hit["lat"]),
        "lon": float(hit["lon"]),
        "display_name": hit.get("display_name", ""),
        "precision": precision,
    }
    cache[key] = result
    return result


# ---------------------------------------------------------------- routing

def osrm_route(a: dict, b: dict) -> dict:
    url = OSRM_URL.format(lon1=a["lon"], lat1=a["lat"], lon2=b["lon"], lat2=b["lat"])
    try:
        r = requests.get(url, params={"overview": "false"}, headers=_ua_headers(), timeout=30)
    except requests.RequestException as e:
        raise DriveTimeError(f"OSRM request failed: {e}") from e
    try:
        data = r.json()
    except ValueError:
        raise DriveTimeError(f"OSRM HTTP {r.status_code}: non-JSON response: {r.text}")
    if r.status_code != 200 or data.get("code") != "Ok" or not data.get("routes"):
        raise DriveTimeError(f"OSRM could not route (HTTP {r.status_code}, code={data.get('code')}): {data.get('message', '')}")
    route = data["routes"][0]
    return {"meters": route["distance"], "seconds": route["duration"]}


def get_google_key() -> str | None:
    key = os.environ.get("GOOGLE_MAPS_API_KEY", "").strip()
    if key:
        return key
    try:
        out = subprocess.run(
            ["security", "find-generic-password", "-s", "google-maps-api-key", "-w"],
            capture_output=True, text=True, timeout=5,
        )
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    except Exception:
        pass
    return None


def google_route(key: str, origin: str, dest: str, depart: dt.datetime | None) -> dict:
    body = {
        "origin": {"address": origin},
        "destination": {"address": dest},
        "travelMode": "DRIVE",
        "routingPreference": "TRAFFIC_AWARE",
        "units": "IMPERIAL",
    }
    if depart is not None:
        body["departureTime"] = depart.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    r = requests.post(
        GOOGLE_ROUTES_URL,
        json=body,
        headers={
            "X-Goog-Api-Key": key,
            "X-Goog-FieldMask": "routes.duration,routes.staticDuration,routes.distanceMeters",
        },
        timeout=30,
    )
    if r.status_code != 200:
        raise DriveTimeError(f"Google Routes HTTP {r.status_code}: {r.text}")
    routes = r.json().get("routes") or []
    if not routes:
        raise DriveTimeError("Google Routes returned no route")
    rt = routes[0]
    secs = lambda s: float(str(s).rstrip("s")) if s else None  # noqa: E731
    return {
        "meters": rt.get("distanceMeters"),
        "traffic_seconds": secs(rt.get("duration")),
        "static_seconds": secs(rt.get("staticDuration")),
    }


# ---------------------------------------------------------------- helpers

def parse_depart(s: str) -> dt.datetime:
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", s.strip())
    if not m or int(m.group(1)) > 23 or int(m.group(2)) > 59:
        raise argparse.ArgumentTypeError(f"--depart must be HH:MM (24h), got {s!r}")
    now = dt.datetime.now().astimezone()
    d = now.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
    if d < now:
        d += dt.timedelta(days=1)  # next occurrence (Google requires a future time)
    return d


def is_rush(d: dt.datetime) -> bool:
    mins = d.hour * 60 + d.minute
    return any(lo <= mins < hi for lo, hi in RUSH_WINDOWS)


def fmt_min(x: float) -> str:
    return f"{round(x)}"


# ---------------------------------------------------------------- main

def main() -> int:
    p = argparse.ArgumentParser(
        prog="drive-time",
        description="Driving distance and time (OSM/OSRM free-flow + traffic estimate range; "
                    "Google Routes live traffic only if a key is configured).",
    )
    p.add_argument("origin", metavar="FROM", help="start address or place name")
    p.add_argument("dest", metavar="TO", help="destination address or place name")
    p.add_argument("--depart", type=parse_depart, metavar="HH:MM",
                   help="local departure time (24h); 07:00-10:00 and 16:00-19:00 count as rush hour")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    args = p.parse_args()

    cache = _load_cache()
    try:
        a = geocode(args.origin, cache)
        b = geocode(args.dest, cache)
    except DriveTimeError as e:
        _save_cache(cache)
        print(f"drive-time: {e}", file=sys.stderr)
        return 1
    _save_cache(cache)

    try:
        route = osrm_route(a, b)
    except DriveTimeError as e:
        print(f"drive-time: {e}", file=sys.stderr)
        return 1

    miles = route["meters"] / METERS_PER_MILE
    free_min = route["seconds"] / 60.0

    if args.depart is None:
        label, mult = "typical traffic", RUSH_MULT
    elif is_rush(args.depart):
        label, mult = f"rush-hour traffic (depart {args.depart:%H:%M})", RUSH_MULT
    else:
        label, mult = f"off-peak traffic (depart {args.depart:%H:%M})", OFFPEAK_MULT
    lo, hi = free_min * mult[0], free_min * mult[1]

    google = None
    gkey = get_google_key()
    if gkey:
        try:
            google = google_route(gkey, args.origin, args.dest, args.depart)
        except Exception as e:  # never let the optional branch break the CLI
            print(f"drive-time: Google Routes failed, using OSRM only: {e}", file=sys.stderr)

    if args.json:
        out = {
            "from": a,
            "to": b,
            "source": "osrm",
            "miles": round(miles, 1),
            "free_flow_minutes": round(free_min, 1),
            "live_traffic": False,
            "traffic_estimate": {
                "label": label,
                "multiplier": list(mult),
                "min_minutes": round(lo),
                "max_minutes": round(hi),
                "is_estimate": True,
            },
            "depart": args.depart.isoformat() if args.depart else None,
            "google": None,
        }
        if google:
            out["google"] = {
                "miles": round(google["meters"] / METERS_PER_MILE, 1) if google["meters"] else None,
                "traffic_minutes": round(google["traffic_seconds"] / 60) if google["traffic_seconds"] else None,
                "static_minutes": round(google["static_seconds"] / 60) if google["static_seconds"] else None,
                "live_traffic": True,
            }
        print(json.dumps(out, indent=2))
        return 0

    print(f"From: {a['display_name']}" + ("" if a["precision"] == "exact" else f"  [{a['precision']}]"))
    print(f"To:   {b['display_name']}" + ("" if b["precision"] == "exact" else f"  [{b['precision']}]"))
    print(f"Distance: {miles:.1f} mi")
    print(f"Free-flow drive: {fmt_min(free_min)} min (OSRM, no live traffic)")
    print(f"{label[0].upper() + label[1:]}: {fmt_min(lo)}-{fmt_min(hi)} min "
          f"(estimate, x{mult[0]}-{mult[1]} of free-flow, not live)")
    if google:
        gm = google["traffic_seconds"]
        print(f"Google Routes (live traffic): {fmt_min(gm / 60)} min"
              + (f", {google['meters'] / METERS_PER_MILE:.1f} mi" if google["meters"] else ""))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
