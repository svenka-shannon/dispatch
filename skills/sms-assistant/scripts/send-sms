#!/usr/bin/env -S uv run --script
"""
send-sms - Unified CLI for sending iMessage/SMS

Usage:
    send-sms <chat_id> "message"              # Send text
    send-sms <chat_id> --image /path/to.png   # Send single image
    send-sms <chat_id> --image img1.png --image img2.png  # Send multiple images
    send-sms <chat_id> --file /path/to.pdf    # Send any file (PDF, doc, etc)
    send-sms <chat_id> "caption" --image /path/to.png  # Send both

Chat ID:
    - Individual: phone number (e.g., +16175551234)
    - Group: hex UUID (e.g., b3d258b9a4de447ca412eb335c82a077)

Examples:
    send-sms +16175551234 "Hello!"
    send-sms +16175551234 --image /tmp/photo.png
    send-sms +16175551234 --image photo1.png --image photo2.png --image photo3.png
    send-sms +16175551234 --file /tmp/document.pdf
    send-sms b3d258b9a4de447ca412eb335c82a077 "Hello group!"
"""

import subprocess
import sys
import os
import re
import shutil
import time
import argparse
import json
from datetime import datetime
from pathlib import Path


def log_perf(metric: str, value: float, **labels) -> None:
    """Log a perf metric to the shared JSONL file."""
    try:
        perf_dir = Path.home() / "dispatch" / "logs"
        perf_dir.mkdir(parents=True, exist_ok=True)
        path = perf_dir / f"perf-{datetime.now():%Y-%m-%d}.jsonl"
        entry = {"v": 1, "ts": datetime.now().isoformat(), "metric": metric, "value": value, "component": "session", **labels}
        with open(path, "a") as f:
            f.write(json.dumps(entry) + "\n")
    except Exception:
        pass  # Never fail on perf logging


# ---------------------------------------------------------------------------
# Wedged-Messages.app detection and recovery
#
# Messages.app can enter a state where the AppleScript account enumeration
# (`1st account whose service type = iMessage`) blocks forever while the app
# still answers trivial queries like `get name`. Observed 2026-08-04 00:09-00:21
# EDT: every outbound send hung for ~12 minutes and the session went silent.
#
# Two layers of protection:
#   1. `with timeout of N seconds` INSIDE the AppleScript turns the infinite
#      block into a returnable AppleEvent error (-1712).
#   2. A `timeout=` on the osascript subprocess catches the case where even the
#      in-script timeout doesn't fire (osascript itself wedged).
# When either fires we force-restart Messages.app and retry the send once.
# ---------------------------------------------------------------------------

# AppleScript-level timeouts (seconds). Text sends are near-instant; attachment
# sends legitimately take longer because Messages copies/uploads the file.
APPLESCRIPT_TEXT_TIMEOUT = 20
APPLESCRIPT_FILE_TIMEOUT = 45
# The subprocess timeout must be strictly larger than the AppleScript timeout so
# the in-script `with timeout` gets a chance to produce a real error first.
SUBPROCESS_TIMEOUT_MARGIN = 10

# Signatures of "Messages.app is wedged", not "the send legitimately failed".
WEDGE_MARKERS = ("-1712", "AppleEvent timed out")

# Recovery timings (seconds).
UNWEDGE_KILL_SETTLE = 3
UNWEDGE_RELAUNCH_SETTLE = 8
UNWEDGE_PROBE_TIMEOUT = 15

BUS_DB_PATH = Path.home() / "dispatch" / "state" / "bus.db"


def emit_bus_event(event_type: str, payload: dict, key: str | None = None) -> None:
    """Fire-and-forget event onto the `system` bus topic.

    send-sms is a standalone `uv run --script` CLI and cannot import the
    daemon's Producer (it would spawn a writer thread and pull in the whole
    assistant package for a sub-second process). This uses the same direct
    sqlite3 insert idiom as `skills/sms-assistant/scripts/reply`: the offset
    comes from the durable topic_offsets counter with the live-table MAX as a
    floor, and the counter is advanced after the INSERT, so the daemon's
    Producer is never wedged by a stale counter.
    """
    try:
        import sqlite3

        if not BUS_DB_PATH.exists():
            return
        conn = sqlite3.connect(str(BUS_DB_PATH), timeout=5)
        try:
            conn.execute("PRAGMA journal_mode=WAL")
            conn.execute("PRAGMA busy_timeout=5000")
            conn.execute("BEGIN IMMEDIATE")
            row = conn.execute(
                'SELECT COALESCE(MAX("offset"), -1) + 1 FROM records '
                "WHERE topic = 'system' AND partition = 0"
            ).fetchone()
            live_next = row[0] if row else 0
            row = conn.execute(
                "SELECT next_offset FROM topic_offsets WHERE topic = 'system' AND partition = 0"
            ).fetchone()
            counter_next = row[0] if row else 0
            next_offset = max(live_next, counter_next)
            conn.execute(
                'INSERT INTO records (topic, partition, "offset", timestamp, key, type, source, payload) '
                "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                ("system", 0, next_offset, int(time.time() * 1000), key,
                 event_type, "send-sms", json.dumps(payload)),
            )
            conn.execute(
                "INSERT INTO topic_offsets (topic, partition, next_offset) VALUES ('system', 0, ?) "
                "ON CONFLICT(topic, partition) DO UPDATE SET next_offset = excluded.next_offset "
                "WHERE excluded.next_offset > topic_offsets.next_offset",
                (next_offset + 1,),
            )
            conn.commit()
        finally:
            conn.close()
    except Exception:
        pass  # Never fail a send because of observability


def messages_pid() -> int | None:
    """PID of the main Messages.app process, or None if it isn't running."""
    try:
        out = subprocess.run(
            ["pgrep", "-f", "Messages.app/Contents/MacOS/Messages"],
            capture_output=True, text=True, timeout=10,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    pids = [int(p) for p in out.split() if p.strip().isdigit()]
    return pids[0] if pids else None


def messages_responsive() -> bool:
    """Cheap probe: can Messages still enumerate its iMessage account?

    Probes the account OBJECT, not `name of` it — accounts have no `name`
    property, so `get name of 1st account ...` returns error -1728 even on a
    perfectly healthy Messages.app. Any non-timeout outcome (including a normal
    AppleScript error) means the app is answering, which is all we need.
    """
    script = f'''
    with timeout of {UNWEDGE_PROBE_TIMEOUT} seconds
        tell application "Messages"
            get 1st account whose service type = iMessage
        end tell
    end timeout
    '''
    try:
        result = subprocess.run(
            ["osascript", "-e", script],
            capture_output=True, text=True,
            timeout=UNWEDGE_PROBE_TIMEOUT + SUBPROCESS_TIMEOUT_MARGIN,
        )
    except subprocess.TimeoutExpired:
        return False
    return not is_wedge_error(result.stderr or "")


def unwedge_messages_app() -> bool:
    """Force-restart Messages.app to clear the wedged-AppleScript state.

    kill -9 is deliberate and NOT a shortcut. During the 2026-08-04 incident
    both `tell application "Messages" to quit` and a plain `pkill -x Messages`
    were tried and BOTH failed — the same PID survived. Only SIGKILL followed by
    `open -a Messages` cleared it, after which sends worked immediately.

    Returns True if Messages came back and answers the account probe.
    """
    pid = messages_pid()
    print(f"UNWEDGE|detected wedged Messages.app (pid={pid})", file=sys.stderr)
    if pid is not None:
        try:
            subprocess.run(["kill", "-9", str(pid)], capture_output=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            print(f"UNWEDGE|failed to kill -9 pid {pid}", file=sys.stderr)
            return False
        time.sleep(UNWEDGE_KILL_SETTLE)

    try:
        subprocess.run(["open", "-a", "Messages"], capture_output=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        print("UNWEDGE|`open -a Messages` failed", file=sys.stderr)
        return False
    time.sleep(UNWEDGE_RELAUNCH_SETTLE)

    ok = messages_responsive()
    print(f"UNWEDGE|{'recovered' if ok else 'still wedged after relaunch'}", file=sys.stderr)
    return ok


def is_wedge_error(text: str) -> bool:
    """True if osascript output carries an AppleEvent-timeout signature."""
    return any(marker in text for marker in WEDGE_MARKERS)


def _timeout_result(script: str, seconds: int) -> subprocess.CompletedProcess:
    """A CompletedProcess standing in for an osascript that never returned."""
    return subprocess.CompletedProcess(
        args=["osascript", "-e", script], returncode=124,
        stdout="", stderr=f"osascript did not return within {seconds}s (AppleEvent timed out)",
    )


def run_osascript(script: str, applescript_timeout: int, context: str) -> subprocess.CompletedProcess:
    """Run a send AppleScript, recovering once from a wedged Messages.app.

    Happy path is identical to a bare subprocess.run: same CompletedProcess,
    same stdout/stderr/returncode. Only on a wedge signature do we force-restart
    Messages.app and retry exactly once (never more) — a wedged app has already
    cost the caller ~30s by this point, and looping would multiply that.

    Note: a retry can in principle duplicate a message if the first send
    actually reached the server before the reply hung. A duplicate is strictly
    better than a silently-dropped reply, which is the failure this fixes.
    """
    subprocess_timeout = applescript_timeout + SUBPROCESS_TIMEOUT_MARGIN

    def attempt() -> subprocess.CompletedProcess:
        try:
            return subprocess.run(
                ["osascript", "-e", script],
                capture_output=True, text=True, timeout=subprocess_timeout,
            )
        except subprocess.TimeoutExpired:
            return _timeout_result(script, subprocess_timeout)

    result = attempt()
    if result.returncode == 0 or not is_wedge_error(result.stderr or ""):
        return result

    emit_bus_event(
        "imessage.send_wedged",
        {
            "context": context,
            "applescript_timeout_s": applescript_timeout,
            "subprocess_timeout_s": subprocess_timeout,
            "returncode": result.returncode,
            "stderr": (result.stderr or "").strip(),
            "messages_pid": messages_pid(),
        },
        key="send-sms",
    )

    if not unwedge_messages_app():
        print(
            "ERROR: Messages.app is wedged and could not be restarted; "
            f"send aborted ({context})",
            file=sys.stderr,
        )
        return result

    print(f"UNWEDGE|retrying send ({context})", file=sys.stderr)
    retry = attempt()
    if retry.returncode != 0 and is_wedge_error(retry.stderr or ""):
        print(
            "ERROR: send timed out again after unwedging Messages.app; giving up "
            f"({context}): {(retry.stderr or '').strip()}",
            file=sys.stderr,
        )
    return retry


def is_group_chat_id(identifier: str) -> bool:
    """Check if identifier looks like a group chat ID (hex string 20+ chars)."""
    return bool(re.match(r'^[a-f0-9]{20,}$', identifier.lower()))


def looks_like_filepath(message: str) -> bool:
    """
    Detect if message looks like a filepath that should have used --image/--file.

    Returns True if message appears to be a filepath, False otherwise.
    """
    msg = message.strip()

    # Skip if empty or very short
    if len(msg) < 4:
        return False

    # Skip URLs - they have paths but are valid text messages
    if msg.startswith(('http://', 'https://', 'ftp://', 'file://')):
        return False

    # Patterns that strongly indicate a filepath:
    # 1. Starts with absolute path indicators
    if msg.startswith('/') or msg.startswith('~/'):
        # Check for common file extensions to be extra sure
        file_extensions = (
            '.png', '.jpg', '.jpeg', '.gif', '.webp', '.heic', '.heif',  # images
            '.mov', '.mp4', '.avi', '.mkv', '.m4v', '.webm',  # video
            '.mp3', '.wav', '.m4a', '.aac', '.flac',  # audio
            '.pdf', '.doc', '.docx', '.txt', '.rtf',  # documents
            '.zip', '.tar', '.gz', '.dmg',  # archives
            '.py', '.js', '.ts', '.sh', '.json', '.yaml', '.yml',  # code
        )
        if any(msg.lower().endswith(ext) for ext in file_extensions):
            return True

        # Also check if path actually exists on disk
        expanded = os.path.expanduser(msg)
        if os.path.exists(expanded):
            return True

    # 2. Common system paths even without leading slash context
    system_path_patterns = [
        r'^/tmp/',
        r'^/Users/',
        r'^/var/',
        r'^/home/',
        r'^/opt/',
        r'^~/Documents/',
        r'^~/Downloads/',
        r'^~/Pictures/',
        r'^~/Desktop/',
    ]
    for pattern in system_path_patterns:
        if re.match(pattern, msg):
            return True

    return False


def resolve_imessage_handle(identifier: str) -> str:
    """Resolve a phone number to its iMessage-capable handle.

    On Mac Minis (no cellular), sending to a phone number may route via SMS
    (which silently fails). This checks chat.db: if the phone only has an SMS
    chat, look for an iMessage chat with the same contact (via email) and
    return that instead.

    Falls back to the original identifier if no better handle is found.
    """
    import sqlite3

    # Only remap phone numbers, not emails or group IDs
    if not identifier.startswith('+'):
        return identifier

    chat_db = Path.home() / "Library" / "Messages" / "chat.db"
    if not chat_db.exists():
        return identifier

    try:
        conn = sqlite3.connect(str(chat_db), timeout=5)
        conn.execute("PRAGMA journal_mode=WAL")
        conn.execute("PRAGMA read_uncommitted=1")

        # Check if this phone number has an iMessage chat (not just SMS)
        row = conn.execute(
            "SELECT service_name FROM chat WHERE chat_identifier = ?",
            (identifier,)
        ).fetchone()

        if row and row[0] == "iMessage":
            # Phone number already routes via iMessage — no remap needed
            conn.close()
            return identifier

        # Phone routes to SMS or doesn't exist. Look for an iMessage chat
        # with the same contact by checking all handles for this contact
        # in macOS Contacts, then finding which one has an iMessage chat.
        #
        # Strategy: find all other handles that share a chat with this phone
        # number (via group chats), or look up contact email from Contacts.app.
        # Simpler: check config.local.yaml for owner mapping, or use the
        # contacts CLI to find the contact's email.

        # First, check if this phone maps to a known contact with an email
        import yaml
        config_path = Path.home() / "dispatch" / "config.local.yaml"
        if config_path.exists():
            with open(config_path) as f:
                config = yaml.safe_load(f) or {}
            owner = config.get("owner", {})
            owner_phone = owner.get("phone", "")
            # If the owner's phone field is an email (iMessage handle), and
            # the identifier matches the signal/phone config, remap
            if owner_phone and '@' in owner_phone:
                signal_phone = config.get("signal", {}).get("account", "")
                if identifier == signal_phone or identifier.lstrip('+') in signal_phone:
                    # This phone number belongs to the owner, use email handle
                    email_chat = conn.execute(
                        "SELECT chat_identifier, service_name FROM chat WHERE chat_identifier = ? AND service_name = 'iMessage'",
                        (owner_phone,)
                    ).fetchone()
                    if email_chat:
                        conn.close()
                        print(f"REMAP|{identifier}|{owner_phone}|iMessage", file=sys.stderr)
                        return owner_phone

        # General fallback: look for any iMessage chat with an email handle
        # that shares the same contact (via AddressBook)
        # For now, try the contacts CLI to get the email
        try:
            contact_result = subprocess.run(
                [str(Path.home() / ".claude" / "skills" / "contacts" / "scripts" / "contacts"),
                 "lookup", identifier],
                capture_output=True, text=True, timeout=5
            )
            if contact_result.returncode == 0:
                # Parse output for email addresses
                for line in contact_result.stdout.strip().split('\n'):
                    if '@' in line:
                        # Extract email from the output
                        parts = line.strip().split()
                        for part in parts:
                            if '@' in part:
                                email = part.strip()
                                # Check if this email has an iMessage chat
                                email_chat = conn.execute(
                                    "SELECT chat_identifier FROM chat WHERE chat_identifier = ? AND service_name = 'iMessage'",
                                    (email,)
                                ).fetchone()
                                if email_chat:
                                    conn.close()
                                    print(f"REMAP|{identifier}|{email}|iMessage", file=sys.stderr)
                                    return email
        except Exception:
            pass

        conn.close()
    except Exception as e:
        print(f"REMAP_ERROR|{identifier}|{e}", file=sys.stderr)

    return identifier


def send_text_individual(phone: str, message: str) -> bool:
    """Send a text message to an individual."""
    # Resolve phone to iMessage handle if needed (prevents SMS routing on Mac Mini)
    resolved = resolve_imessage_handle(phone)
    if resolved != phone:
        print(f"Resolved {phone} -> {resolved} (iMessage)", file=sys.stderr)

    # Escape for AppleScript (backslashes first, then quotes)
    escaped = message.replace('\\', '\\\\').replace('"', '\\"')
    script = f'''
    with timeout of {APPLESCRIPT_TEXT_TIMEOUT} seconds
        tell application "Messages"
            set targetService to 1st account whose service type = iMessage
            set targetBuddy to buddy "{resolved}" of targetService
            send "{escaped}" to targetBuddy
        end tell
    end timeout
    return "SENT|{resolved}"
    '''
    result = run_osascript(script, APPLESCRIPT_TEXT_TIMEOUT, "text_individual")
    if result.returncode == 0:
        print(result.stdout.strip())
        return True
    else:
        print(f"ERROR: {result.stderr.strip()}", file=sys.stderr)
        return False


def send_text_group(chat_id: str, message: str) -> bool:
    """Send a text message to a group chat."""
    # Escape for AppleScript (backslashes first, then quotes)
    escaped = message.replace('\\', '\\\\').replace('"', '\\"')
    script = f'''
    with timeout of {APPLESCRIPT_TEXT_TIMEOUT} seconds
        tell application "Messages"
            repeat with aChat in chats
                if id of aChat contains "{chat_id}" then
                    send "{escaped}" to aChat
                    return "SENT_GROUP|{chat_id}"
                end if
            end repeat
            return "ERROR|chat_not_found"
        end tell
    end timeout
    '''
    result = run_osascript(script, APPLESCRIPT_TEXT_TIMEOUT, "text_group")
    output = result.stdout.strip()
    if result.returncode == 0 and "SENT_GROUP" in output:
        print(output)
        return True
    else:
        error = result.stderr.strip() or output
        print(f"ERROR: {error}", file=sys.stderr)
        return False


def send_image_individual(phone: str, image_path: str) -> bool:
    """Send an image to an individual.

    IMPORTANT: Due to a macOS bug (Monterey through Sequoia), images must be
    sent from ~/Pictures folder. This copies the image there temporarily.
    """
    # Resolve phone to iMessage handle if needed
    resolved = resolve_imessage_handle(phone)
    if resolved != phone:
        print(f"Resolved {phone} -> {resolved} (iMessage)", file=sys.stderr)

    # Copy to Pictures folder (macOS bug workaround)
    pictures_dir = Path.home() / "Pictures"
    filename = Path(image_path).name
    temp_path = pictures_dir / filename

    try:
        shutil.copy2(image_path, temp_path)

        script = f'''
        set theFile to POSIX file "{temp_path}"
        with timeout of {APPLESCRIPT_FILE_TIMEOUT} seconds
            tell application "Messages"
                set targetService to 1st account whose service type = iMessage
                set targetBuddy to buddy "{resolved}" of targetService
                send file theFile to targetBuddy
            end tell
        end timeout
        return "SENT_IMAGE|{resolved}|{filename}"
        '''
        result = run_osascript(script, APPLESCRIPT_FILE_TIMEOUT, "image_individual")

        # Wait for send to start before cleanup
        time.sleep(2)

        if result.returncode == 0:
            print(result.stdout.strip())
            return True
        else:
            print(f"ERROR: {result.stderr.strip()}", file=sys.stderr)
            return False
    finally:
        # Clean up temp file
        if temp_path.exists():
            temp_path.unlink()


def send_image_group(chat_id: str, image_path: str) -> bool:
    """Send an image to a group chat.

    IMPORTANT: Due to a macOS bug, images must be sent from ~/Pictures folder.
    """
    # Copy to Pictures folder (macOS bug workaround)
    pictures_dir = Path.home() / "Pictures"
    filename = Path(image_path).name
    temp_path = pictures_dir / filename

    try:
        shutil.copy2(image_path, temp_path)

        script = f'''
        set theFile to POSIX file "{temp_path}"
        with timeout of {APPLESCRIPT_FILE_TIMEOUT} seconds
            tell application "Messages"
                repeat with aChat in chats
                    if id of aChat contains "{chat_id}" then
                        send file theFile to aChat
                        return "SENT_IMAGE_GROUP|{chat_id}|{filename}"
                    end if
                end repeat
                return "ERROR|chat_not_found"
            end tell
        end timeout
        '''
        result = run_osascript(script, APPLESCRIPT_FILE_TIMEOUT, "image_group")

        # Wait for send to start before cleanup
        time.sleep(2)

        output = result.stdout.strip()
        if result.returncode == 0 and "SENT_IMAGE_GROUP" in output:
            print(output)
            return True
        else:
            error = result.stderr.strip() or output
            print(f"ERROR: {error}", file=sys.stderr)
            return False
    finally:
        # Clean up temp file
        if temp_path.exists():
            temp_path.unlink()


